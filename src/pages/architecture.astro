        <!-- Threat feed pipeline -->
        <div class="mt-10 reveal">
          <DiagramFrame tone="amber" eyebrow="Detection → enforcement loop" title="Public Threat Feed Pipeline">
            <DiagramLane label="Inputs" tone="amber" cols={3} connector={true}>
              <DiagramNode tone="red" icon="📡" title="Edge agents / bouncers" sub="over Tailscale" />
              <DiagramNode tone="red" icon="🔷" title="Azure site attacks" sub="reported as sensor" />
              <DiagramNode tone="red" icon="🌍" title="CAPI + console lists" sub="community blocklists" />
            </DiagramLane>
            <DiagramLane label="Engine" tone="amber" cols={1} connector={true}>
