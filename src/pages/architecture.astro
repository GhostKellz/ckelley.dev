            </DiagramLane>
            <DiagramLane label="Published" tone="amber" cols={1} connector={true}>
              <DiagramNode tone="amber" variant="solid" glow={true} icon="📄"
                title="threat.cktechnology.io/crowdsec.txt" sub="public · plaintext IP/CIDR list" />
            </DiagramLane>
            <DiagramLane label="Consumed" tone="amber" cols={1}>
              <DiagramNode tone="teal" variant="solid" icon="🛡️" title="FortiGate external feed (pull)"
                sub="address object → IPv4 DENY policy" />
            </DiagramLane>
            <Fragment slot="legend">
              <span>An attack on the public Azure site is blocked at the FortiGate for every other service — closed loop.</span>
            </Fragment>
          </DiagramFrame>
