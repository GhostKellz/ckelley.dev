---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navigation from '@components/Navigation.astro';
import SectionNav from '@components/SectionNav.astro';
import DiagramFrame from '@components/diagram/DiagramFrame.astro';
import DiagramLane from '@components/diagram/DiagramLane.astro';
import DiagramNode from '@components/diagram/DiagramNode.astro';
import LogPipelineFlow from '@components/diagram/flows/LogPipelineFlow.astro';
import MetricsPipelineFlow from '@components/diagram/flows/MetricsPipelineFlow.astro';
import SecurityOverlayFlow from '@components/diagram/flows/SecurityOverlayFlow.astro';
import DeploymentTopologyFlow from '@components/diagram/flows/DeploymentTopologyFlow.astro';
import FortiGateSdwanFlow from '@components/diagram/flows/FortiGateSdwanFlow.astro';
import SdwanLoadBalanceFlow from '@components/diagram/flows/SdwanLoadBalanceFlow.astro';
import ServerLoadBalanceFlow from '@components/diagram/flows/ServerLoadBalanceFlow.astro';
import SslInspectionFlow from '@components/diagram/flows/SslInspectionFlow.astro';
import Layer7FilterFlow from '@components/diagram/flows/Layer7FilterFlow.astro';
import LiveMigrationFlow from '@components/diagram/flows/LiveMigrationFlow.astro';
import LookingGlassFlow from '@components/diagram/flows/LookingGlassFlow.astro';
import IommuSplitFlow from '@components/diagram/flows/IommuSplitFlow.astro';
import CudaDeliveryFlow from '@components/diagram/flows/CudaDeliveryFlow.astro';
import CudaClusterFlow from '@components/diagram/flows/CudaClusterFlow.astro';
import RaidRedundancyFlow from '@components/diagram/flows/RaidRedundancyFlow.astro';
import NvidiaContainerToolkitFlow from '@components/diagram/flows/NvidiaContainerToolkitFlow.astro';
import ContainerDriverSplitFlow from '@components/diagram/flows/ContainerDriverSplitFlow.astro';
import BackupStrategyFlow from '@components/diagram/flows/BackupStrategyFlow.astro';
import ArchBackupFlow from '@components/diagram/flows/ArchBackupFlow.astro';
import ProxmoxBackupFlow from '@components/diagram/flows/ProxmoxBackupFlow.astro';
import VeeamBackupFlow from '@components/diagram/flows/VeeamBackupFlow.astro';
import BackupEncryptionFlow from '@components/diagram/flows/BackupEncryptionFlow.astro';
import AIWorkflowDiagram from '@components/diagram/AIWorkflowDiagram.astro';
import SectionHeading from '@components/SectionHeading.astro';
import '@styles/global.css';

const navSections = [
  { id: 'top', label: 'Top' },
  { id: 'topology', label: 'Topology' },
  { id: 'edge', label: 'Edge & SD-WAN' },
  { id: 'virtualization', label: 'Virtualization' },
  { id: 'workstation', label: 'Workstation' },
  { id: 'backup', label: 'Backup & DR' },
  { id: 'raid', label: 'RAID & Redundancy' },
  { id: 'cuda', label: 'CUDA' },
  { id: 'ai', label: 'AI' },
  { id: 'security', label: 'Security' },
  { id: 'observability', label: 'Observability' },
  { id: 'dataflow', label: 'Follow the Data' },
];

const domains = [
  { id: 'virtualization', label: 'Virtualization', icon: '🧮', tone: 'text-blue-light', body: 'A nine-node Proxmox cluster with HA, ZFS, SDN, and GPU passthrough.' },
  { id: 'ai', label: 'AI / Inference', icon: '🧠', tone: 'text-violet-light', body: 'Local-first inference across multiple GPUs, vLLM, SGLang, LiteLLM routing, and Hermes orchestration.' },
  { id: 'security', label: 'Security', icon: '🛡️', tone: 'text-danger-light', body: 'Distributed CrowdSec, FortiGate edge, DNS failover, all infra over Tailscale.' },
  { id: 'observability', label: 'Observability', icon: '📊', tone: 'text-emerald-light', body: 'Heimdall: metrics, logs, and SIEM into a single tailnet-only pane of glass.' },
];
---

<BaseLayout
  title="Architecture | Christopher Kelley"
  description="A whole-stack architecture deep-dive: dual-WAN FortiGate SD-WAN, a Proxmox cluster with VFIO GPU passthrough, local-first AI inference with vLLM, LiteLLM, and a DGX Spark cluster, distributed CrowdSec security with a public threat feed, and full Heimdall observability, all wired over a Tailscale control plane."
>
  <Navigation />
  <SectionNav sections={navSections} />

  <main class="pt-24">
    <!-- Hero -->
    <section id="top" class="section pb-10">
      <div class="container-narrow text-center">
        <p class="heading-accent">Architecture</p>
        <h1 class="text-4xl md:text-5xl font-bold text-slate-light mb-4">
          The Whole Stack, <span class="text-gradient">End to End</span>
        </h1>
        <p class="text-slate max-w-2xl mx-auto leading-relaxed">
          One environment spanning virtualization, AI, security, and observability. Everything is
          designed, built, and operated as a single system. This is how the pieces actually fit together:
          the topology, the dataflows, and the decisions behind them.
        </p>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mt-10 max-w-3xl mx-auto">
          {domains.map(d => (
            <a href={`#${d.id}`} class="card py-5 px-4 text-center group">
              <span class="text-2xl block mb-2">{d.icon}</span>
              <p class={`font-semibold text-sm ${d.tone}`}>{d.label}</p>
              <p class="text-slate text-xs mt-1 leading-relaxed">{d.body}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Global Topology ─────────────────────────────────────────── -->
    <section id="topology" class="section py-16 bg-navy-light/30">
      <div class="container-narrow">
        <div class="mb-8 text-center">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-light mb-2">
            <span class="text-accent">⟨</span> Global Topology <span class="text-accent">⟩</span>
          </h2>
          <p class="text-slate max-w-2xl mx-auto">
            Two WAN links into a FortiGate edge, a local Proxmox cluster, a cloud node, a public
            DMZ, and a second homelab, all stitched together by a Tailscale control plane so management
            never crosses the public internet.
          </p>
        </div>

        <div class="reveal">
          <DiagramFrame tone="teal" scroll={true} eyebrow="Edge → Core → Sites">
            <!-- WAN -->
            <DiagramLane label="WAN Uplinks" tone="aqua" cols={2} connector={true}>
              <DiagramNode tone="aqua" icon="🌐" title="Fiber 2.5 GbE" sub="Primary" />
              <DiagramNode tone="aqua" icon="🌐" title="Cable 950/40" sub="Backup" />
            </DiagramLane>

            <!-- Edge -->
            <DiagramLane label="Edge" tone="teal" cols={1} connector={true}>
              <DiagramNode tone="teal" variant="solid" glow={true} icon="🛡️"
                title="FortiGate SD-WAN"
                sub="Failover · SLA steering · IPS / UTM · threat feeds" />
            </DiagramLane>

            <!-- Resolution & Core -->
            <DiagramLane label="Resolution & Core" tone="blue" cols={3} connector={true}>
              <DiagramNode tone="blue" icon="🧭" title="Technitium DNS" sub="→ Unbound" />
              <DiagramNode tone="blue" icon="🕳️" title="Pi-hole" sub="→ Unbound" />
              <DiagramNode tone="blue" icon="🔀" title="Core Switch" sub="VLAN trunk · LACP" />
            </DiagramLane>

            <!-- Sites & Segments -->
            <DiagramLane label="Sites & Segments" tone="teal" cols={5}>
              <DiagramNode tone="blue" variant="solid" icon="🧮"
                title="Local PVE Cluster"
                sub="chromium · palladium · osmium · prometheus · rhenium · 10.0.0.0/24" />
              <DiagramNode tone="red" variant="solid" icon="🌩️"
                title="DMZ · thallium"
                sub="nginx + Docker · public" />
              <DiagramNode tone="violet" variant="solid" icon="☁️"
                title="Cloud PVE1"
                sub="cktech-nginx · 10.10.10.0/24" />
              <DiagramNode tone="red" variant="solid" icon="🔷"
                title="Azure · ckel-web-01"
                sub="public web · CrowdSec bouncer" />
              <DiagramNode tone="amber" variant="solid" icon="🧪"
                title="Second Homelab"
                sub="Lab40 VLAN → Lab-40F 90G · Hyper-V ×2 + Veeam" />
            </DiagramLane>

            <!-- Backup band -->
            <div class="mt-6">
              <DiagramLane label="Backup & DR" tone="emerald" cols={3}>
                <DiagramNode tone="emerald" icon="🗃️" title="Synology NAS" sub="Active Backup · M365 / Workspace" />
                <DiagramNode tone="emerald" icon="🧷" title="Proxmox Backup Server" sub="dedup · encrypted" />
                <DiagramNode tone="emerald" icon="☁️" title="Wasabi S3" sub="offsite · 3-2-1" />
              </DiagramLane>
            </div>

            <!-- Tailscale overlay band -->
            <div class="mt-8 rounded-lg border border-accent/30 bg-accent/5 px-5 py-4 text-center" style="box-shadow: 0 0 24px -8px #64ffda;">
              <p class="text-accent font-mono text-xs uppercase tracking-wider mb-1">Control Plane Overlay</p>
              <p class="text-slate-light text-sm">
                🔗 The Tailscale mesh spans every site. All infra comms (SSH, LAPI, Wazuh, dashboards)
                ride the tailnet with strict ACLs and per-session SSH auth.
              </p>
            </div>

            <Fragment slot="legend">
              <span><span class="inline-block w-2.5 h-2.5 rounded-full bg-blue align-middle mr-1.5"></span>Internal LAN / cluster</span>
              <span><span class="inline-block w-2.5 h-2.5 rounded-full bg-danger align-middle mr-1.5"></span>Public surface / DMZ</span>
              <span><span class="inline-block w-2.5 h-2.5 rounded-full bg-violet align-middle mr-1.5"></span>Cloud</span>
              <span><span class="inline-block w-2.5 h-2.5 rounded-full bg-amber align-middle mr-1.5"></span>Second site</span>
              <span><span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald align-middle mr-1.5"></span>Backup / DR</span>
            </Fragment>
          </DiagramFrame>
        </div>

        <div class="space-y-4 text-slate leading-relaxed max-w-3xl mx-auto mt-10">
          <p>
            The edge is a <span class="text-accent font-semibold">FortiGate</span> bonding a 2.5 GbE fiber line
            with a cable circuit into one resilient pipe, where SD-WAN health checks fail traffic over
            if a link drops and SLA-based steering keeps latency-sensitive workloads on the best path.
            Behind it, a dual-resolver DNS setup and a VLAN-trunked core fan out to the
            <span class="text-accent font-semibold">local Proxmox cluster</span> on
            <span class="text-accent font-semibold">10.0.0.0/24</span>, a cloud Proxmox node on its own
            <span class="text-accent font-semibold">10.10.10.0/24</span> SDN, a public DMZ, and a separate
            second homelab on its own VLAN and firewall.
          </p>
          <p>
            The piece that ties it all together is <span class="text-accent font-semibold">Tailscale</span>.
            Rather than exposing management interfaces, every site joins one tailnet and all
            administrative traffic (SSH, the CrowdSec LAPI, the Wazuh indexer, Grafana and Prometheus)
            rides that overlay with strict ACLs and authenticated SSH on every session. The only things
            deliberately facing the public internet are a hardened web front door and a single
            threat-feed endpoint, both isolated from the internal estate.
          </p>
        </div>
      </div>
    </section>

    <!-- ── Edge & SD-WAN (FortiGate) ───────────────────────────────── -->
    <section id="edge" class="section py-16">
      <div class="container-narrow">
        <div class="mb-8 text-center">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-light mb-2">
            <span class="text-aqua-light">⟨</span> The FortiGate Edge <span class="text-aqua-light">⟩</span>
          </h2>
          <p class="text-slate max-w-2xl mx-auto">
            One FortiGate 90G doing real enterprise work. SD-WAN, server and link load balancing,
            full deep-SSL inspection, and Layer-7 filtering all run without giving up line-rate throughput.
          </p>
        </div>

        <!-- Speeds & feeds callout band -->
        <div class="mb-12 rounded-lg border border-aqua-light/30 bg-aqua-light/5 px-5 py-5 reveal" style="box-shadow: 0 0 24px -8px #22d3ee;">
          <p class="text-aqua-light font-mono text-xs uppercase tracking-wider mb-3 text-center">Speeds &amp; Feeds · Line-Rate With the Brain On</p>
          <ul class="text-slate-light text-sm max-w-3xl mx-auto leading-relaxed space-y-1.5 list-none">
            <li>⚡ <span class="text-accent font-semibold">2.5 Gbps symmetric</span> internet on the WAN1 fiber (static block), sustained with <span class="text-accent font-semibold">Full SSL Inspection + IPS + Fortinet threat protection</span> all enabled.</li>
            <li>🔀 The <span class="text-accent font-semibold">10 GbE WAN port repurposed as the LAN uplink</span> → 10 G UniFi switch → 2.5 G access switches; a 1 GbE LAN port redefined as <span class="text-accent font-semibold">WAN2</span>, the cable backup for SD-WAN failover.</li>
            <li>🧮 <span class="text-accent font-semibold">10 G east-west</span> between the Arch workstation and the entire PVE cluster + backup hosts, VLAN-segmented on the switched fabric.</li>
            <li>📶 <span class="text-accent font-semibold">2× U7 Pro XG</span> delivering ≈1.5 Gbps symmetric Wi-Fi; Guest50 and IOT60 client-isolated via the UniFi Network Controller.</li>
          </ul>
        </div>

        <!-- SD-WAN -->
        <div class="reveal">
          <DiagramFrame tone="aqua" scroll={true} eyebrow="SD-WAN" title={'Failover & SLA Steering'}>
            <FortiGateSdwanFlow />
            <Fragment slot="legend">
              <span><span class="inline-block w-6 align-middle mr-1.5" style="border-top:1.5px dotted #fbbf24;"></span>Dotted = Performance SLA feeding the steering decision</span>
            </Fragment>
          </DiagramFrame>
        </div>

        <!-- SD-WAN link load balancing -->
        <div class="mt-10 reveal">
          <DiagramFrame tone="aqua" scroll={true} eyebrow="Load Balancing · 1 of 2" title="SD-WAN Link Load Balancing">
            <SdwanLoadBalanceFlow />
            <Fragment slot="legend">
              <span>Both WAN members carry traffic at once, split by bandwidth ratio. This is aggregation, not failover.</span>
            </Fragment>
          </DiagramFrame>
        </div>

        <!-- Server load balancing -->
        <div class="mt-10 reveal">
          <DiagramFrame tone="aqua" scroll={true} eyebrow="Load Balancing · 2 of 2" title="Server Load Balancing (VIP → Pool)">
            <ServerLoadBalanceFlow />
            <Fragment slot="legend">
              <span>Virtual Server VIP offloads SSL and balances across a health-checked nginx pool with persistence.</span>
            </Fragment>
          </DiagramFrame>
        </div>

        <!-- Full SSL inspection -->
        <div class="mt-10 reveal">
          <DiagramFrame tone="aqua" scroll={true} eyebrow="Deep inspection" title="Full SSL Inspection · Controlled MITM">
            <SslInspectionFlow />
            <Fragment slot="legend">
              <span>Two TLS sessions: the FortiGate re-signs with <span class="text-accent font-semibold">CKEL_ROOT_CA</span> to the client while validating the origin's real cert.</span>
              <span><span class="inline-block w-6 align-middle mr-1.5" style="border-top:1.5px dotted #fbbf24;"></span>Dotted = decrypted payload handed to inspection</span>
            </Fragment>
          </DiagramFrame>
        </div>

        <!-- Layer 7 filtering -->
        <div class="mt-10 reveal">
          <DiagramFrame tone="aqua" scroll={true} eyebrow="Application layer" title="How Layer-7 Filtering Works">
            <Layer7FilterFlow />
            <Fragment slot="legend">
              <span>Decrypted payload fans out to every L7 module in parallel; their combined result is one policy verdict.</span>
            </Fragment>
          </DiagramFrame>
        </div>

        <div class="space-y-4 text-slate leading-relaxed max-w-3xl mx-auto mt-10">
          <p>
            The edge is a single <span class="text-accent font-semibold">FortiGate 90G</span> pushed well past a
            typical home deployment. <span class="text-accent font-semibold">SD-WAN</span> bonds a 2.5 GbE fiber
            primary with a 1 GbE cable backup in the <span class="text-accent font-semibold">wan-failover-link</span>
            zone, where Performance SLA health probes drive both automatic failover and application-aware
            steering. When configured for it, SD-WAN also spreads sessions across both links at once by
            bandwidth ratio for aggregate throughput.
          </p>
          <p>
            On the application side, a <span class="text-accent font-semibold">Virtual Server</span> offloads SSL and
            load-balances across a health-checked nginx pool, while
            <span class="text-accent font-semibold">Full SSL Inspection</span> acts as a controlled man-in-the-middle:
            the FortiGate terminates two TLS sessions, re-signing to managed clients with its own
            <span class="text-accent font-semibold">CKEL_ROOT_CA</span> while validating each origin's real
            certificate. That decrypted stream is what makes <span class="text-accent font-semibold">Layer-7
            filtering</span> possible. Application control, web filtering, IPS, antivirus, DNS filtering and
            DLP all inspect the payload in the clear before it is re-encrypted and a single policy verdict is
            applied. The notable part is doing all of this at <span class="text-accent font-semibold">2.5 Gbps
            symmetric</span> with inspection fully enabled.
          </p>
        </div>
      </div>
    </section>

    <!-- ── Virtualization ──────────────────────────────────────────── -->
    <section id="virtualization" class="section py-16">
      <div class="container-narrow">
        <div class="mb-8 text-center">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-light mb-2">
            <span class="text-blue-light">⟨</span> Virtualization &amp; Compute <span class="text-blue-light">⟩</span>
          </h2>
          <p class="text-slate max-w-2xl mx-auto">
            A nine-node Proxmox cluster for server workloads with HA failover, ZFS everywhere, and
            segmented SDN, where KVM runs Windows, Linux, and macOS (via OpenCore) guests, so any
            OS can be spun up and tested on real hardware, with VFIO passthrough for GPU-bound work.
          </p>
        </div>

        <!-- ── Proxmox cluster (server) ── -->
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-3 mb-12 reveal">
          <DiagramNode tone="blue" variant="solid" icon="🧮" title="Proxmox VE Cluster" sub="Corosync quorum · HA · live migration" />
          <DiagramNode tone="blue" variant="solid" icon="🗄️" title="ZFS Storage" sub="NVMe mirrors · RAIDz2 · zstd · scrubs" />
          <DiagramNode tone="blue" variant="solid" icon="🕸️" title="SDN" sub="VLAN-aware bridges · VXLAN/EVPN · LACP" />
          <DiagramNode tone="blue" variant="solid" icon="📜" title="Cloud-Init / IaC" sub="golden templates · Terraform · Ansible" />
        </div>

        <!-- Live migration flow -->
        <div class="reveal">
          <DiagramFrame tone="blue" eyebrow="Pre-copy memory migration" title="Live Migration">
            <LiveMigrationFlow />
            <Fragment slot="legend">
              <span class="inline-flex items-center gap-1.5">
                <span class="inline-block w-6 border-t border-dashed border-slate"></span>
                dotted = storage stays put (shared / ZFS-replicated)
              </span>
            </Fragment>
          </DiagramFrame>
        </div>

        <div class="space-y-4 text-slate leading-relaxed max-w-3xl mx-auto mt-10">
          <p>
            The compute layer is a nine-node <span class="text-accent font-semibold">Proxmox VE</span> cluster
            spanning everything from an EPYC server to small-form-factor boxes, tied together with
            Corosync quorum and HA so guests live-migrate and restart automatically when a node drops.
            Storage is <span class="text-accent font-semibold">ZFS</span> end to end. NVMe mirrors and RAIDz2
            pools run compression and scheduled scrubs, and their snapshots feed both replication
            between nodes and the backup chain.
          </p>
        </div>

        <!-- Multi-OS guest cards (KVM runs any OS) -->
        <div class="grid md:grid-cols-3 gap-3 mt-12 mb-6 reveal">
          <DiagramNode tone="blue" variant="solid" icon="🪟" title="Windows guests" sub="VirtIO drivers · GPU passthrough when needed" />
          <DiagramNode tone="blue" variant="solid" icon="🐧" title="Linux guests" sub="any distro · cloud-init golden templates" />
          <DiagramNode tone="blue" variant="solid" icon="🍎" title="macOS guests" sub="OpenCore + KVM · cross-platform testing" />
        </div>

        <div class="space-y-4 text-slate leading-relaxed max-w-3xl mx-auto mb-12">
          <p>
            Because everything runs on <span class="text-accent font-semibold">KVM</span>, the cluster can boot
            virtually any operating system, from Windows and any Linux distro to
            <span class="text-accent font-semibold">macOS via OpenCore</span>. A guest is available for testing
            on essentially <span class="text-accent font-semibold">any OS environment</span> on real hardware,
            without dedicated machines or dual-booting.
          </p>
        </div>

        <!-- VFIO passthrough workflow -->
        <div class="reveal">
          <DiagramFrame tone="blue" eyebrow="Workflow" title="VFIO GPU Passthrough">
            <DiagramLane tone="blue" cols={1} connector={true}>
              <DiagramNode tone="blue" icon="🔧" title="Enable IOMMU on the host"
                sub="amd_iommu=on · iommu=pt · isolate the IOMMU group" />
            </DiagramLane>
            <DiagramLane tone="blue" cols={1} connector={true}>
              <DiagramNode tone="blue" icon="🔌" title="Bind GPU to vfio-pci"
                sub="blacklist host driver · stub the device at boot" />
            </DiagramLane>
            <DiagramLane tone="blue" cols={1} connector={true}>
              <DiagramNode tone="blue" icon="🖥️" title="q35 + OVMF guest"
                sub="PCIe passthrough · GPU + audio function · reset handling" />
            </DiagramLane>
            <DiagramLane tone="blue" cols={1}>
              <DiagramNode tone="violet" variant="solid" glow={true} icon="⚡" title="Guest = near bare-metal GPU"
                sub="RTX 4090 inference VM · isolated compute node" />
            </DiagramLane>
          </DiagramFrame>
        </div>

        <div class="space-y-4 text-slate leading-relaxed max-w-3xl mx-auto mt-10">
          <p>
            For workloads that need real hardware, <span class="text-accent font-semibold">VFIO passthrough</span>
            isolates a GPU's IOMMU group, binds it to <span class="text-accent font-semibold">vfio-pci</span>, and
            hands it straight into a q35/OVMF guest, so a full RTX 4090 runs inside a VM at close to
            bare-metal speed as a dedicated inference node.
          </p>
        </div>
      </div>
    </section>

    <!-- ── Arch Workstation · Looking Glass ───────────────────────── -->
    <section id="workstation" class="section py-16 bg-navy-light/30">
      <div class="container-narrow">
        <div class="mb-8 text-center">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-light mb-2">
            <span class="text-violet-light">⟨</span> Arch Workstation · High-Perf Virtualization <span class="text-violet-light">⟩</span>
          </h2>
          <p class="text-slate max-w-2xl mx-auto">
            Separate from the cluster: a single <span class="text-accent font-semibold">Arch Linux</span> daily
            driver (Ryzen 9950X3D · RTX 5090) where <span class="text-accent font-semibold">KVM + VFIO passthrough</span>
            hands a real GPU to a Windows guest, and <span class="text-accent font-semibold">Looking Glass</span>
            mirrors it back as a lossless, near bare-metal desktop.
          </p>
        </div>

        <!-- Looking Glass runtime data path -->
        <div class="reveal">
          <DiagramFrame tone="violet" eyebrow="Arch Linux (KVM + VFIO) → Windows guest · lossless video" title="Looking Glass" scroll={true}>
            <LookingGlassFlow />
            <Fragment slot="legend">
              <span class="inline-flex items-center gap-1.5">
                <span class="inline-block w-6 border-t border-dashed border-slate"></span>
                dotted = keyboard / mouse fed back to the guest · frames are uncompressed, never leave RAM
              </span>
            </Fragment>
          </DiagramFrame>
        </div>

        <div class="space-y-4 text-slate leading-relaxed max-w-3xl mx-auto mt-10">
          <p>
            The daily driver runs <span class="text-accent font-semibold">Arch Linux</span> as the KVM host.
            <span class="text-accent font-semibold">VFIO passthrough</span> isolates the GPU's IOMMU group, binds it
            to <span class="text-accent font-semibold">vfio-pci</span>, and hands it into a q35/OVMF
            <span class="text-accent font-semibold">Windows guest</span>, so the VM drives a real GPU at close to
            bare-metal speed.
          </p>
          <p>
            <span class="text-accent font-semibold">Looking Glass</span> then copies each guest frame through an
            <span class="text-accent font-semibold">IVSHMEM</span> shared-memory region into a client on the Arch
            host. The result is an uncompressed, low-latency desktop with no video encode and no network
            hop, so 3D apps and CUDA workloads inside Windows run at effectively bare-metal performance,
            in a window right alongside Linux.
          </p>
        </div>

        <!-- GPU / IOMMU split -->
        <div class="mt-10 reveal">
          <DiagramFrame tone="violet" eyebrow="Why it works · clean IOMMU groups" title="GPU Split: vfio-pci vs host" scroll={true}>
            <IommuSplitFlow />
            <Fragment slot="legend">
              <span class="inline-flex items-center gap-1.5">
                <span class="inline-block w-3 h-3 rounded-sm" style="background:#a855f7"></span>
                isolated → Windows guest
              </span>
              <span class="inline-flex items-center gap-1.5">
                <span class="inline-block w-3 h-3 rounded-sm" style="background:#64ffda"></span>
                retained → Arch host
              </span>
            </Fragment>
          </DiagramFrame>
        </div>

        <div class="space-y-4 text-slate leading-relaxed max-w-3xl mx-auto mt-10">
          <p>
            The split only works because the GPUs land in clean
            <span class="text-accent font-semibold">IOMMU groups</span>. The discrete
            <span class="text-accent font-semibold">RTX 5090</span>, along with its HDMI-audio function, is stubbed to
            <span class="text-accent font-semibold">vfio-pci</span> at boot and handed whole to the guest, while the
            CPU's <span class="text-accent font-semibold">Radeon iGPU</span> keeps the native
            <span class="text-accent font-semibold">amdgpu</span> driver and drives the Arch desktop, so the host
            still has a display to render the Looking Glass client into.
          </p>
          <p>
            This is the same approach on both the cluster and the workstation: I
            <span class="text-accent font-semibold">spec motherboards with proper IOMMU support</span> up front so
            devices land in clean groups on their own. <span class="text-accent font-semibold">ACS-override
            patches</span> work and have been reliable enough when I've needed them, but choosing
            hardware that groups correctly removes the need for them entirely. The payoff is fewer
            kernel patches, cleaner upgrades, and predictable passthrough.
          </p>
        </div>
      </div>
    </section>

    <!-- ── Backup & DR ─────────────────────────────────────────────── -->
    <section id="backup" class="section py-16">
      <div class="container-narrow">
        <div class="mb-8 text-center">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-light mb-2">
            <span class="text-emerald-light">⟨</span> Backup &amp; Disaster Recovery <span class="text-emerald-light">⟩</span>
          </h2>
          <p class="text-slate max-w-2xl mx-auto">
            Every dataset rides a <span class="text-accent font-semibold">3-2-1</span> footing, and the restores
            are tested, not assumed. Each platform has its own chain, all converging on encrypted offsite
            copies in Wasabi.
          </p>
        </div>

        <!-- 3-2-1 explainer -->
        <div class="rounded-xl border border-emerald-light/30 bg-navy-light/40 p-5 md:p-6 mb-12 reveal"
          style="box-shadow: 0 0 24px -8px #34d399;">
          <p class="text-sm uppercase tracking-wider text-emerald-light font-mono mb-3">What 3-2-1 means</p>
          <ul class="grid sm:grid-cols-3 gap-4 text-slate text-sm leading-relaxed">
            <li><span class="text-accent font-semibold">3 copies</span> means the live data plus two
              backups, so a single loss is never fatal.</li>
            <li><span class="text-accent font-semibold">2 media types</span> means on-disk ZFS/NVMe plus a
              separate backup appliance (PBS / Synology / Veeam repo), so one failure mode can't take both.</li>
            <li><span class="text-accent font-semibold">1 offsite</span> means a geo-separated, encrypted
              copy in Wasabi that survives a site-level disaster.</li>
          </ul>
          <p class="text-slate text-sm mt-4 pt-4 border-t border-slate-dark/60">
            The unofficial <span class="text-accent font-semibold">+1</span>: restores are rehearsed on a schedule.
            A backup you haven't restored is a hope, not a recovery plan.
          </p>
        </div>

        <!-- 3-2-1 flow -->
        <div class="reveal">
          <DiagramFrame tone="emerald" eyebrow="The rule, visualized" title="3-2-1 Backup Strategy">
            <BackupStrategyFlow />
          </DiagramFrame>
        </div>

        <!-- Arch workstation -->
        <div class="mt-10 reveal">
          <DiagramFrame tone="emerald" eyebrow="Daily driver" title="Arch · btrfs / snapper / restic" scroll={true}>
            <ArchBackupFlow />
            <Fragment slot="legend">
              <span class="inline-flex items-center gap-1.5">
                snapper = instant local rollback · restic = encrypted file-level offsite
              </span>
            </Fragment>
          </DiagramFrame>
        </div>

        <!-- Proxmox cluster -->
        <div class="mt-10 reveal">
          <DiagramFrame tone="emerald" eyebrow="Cluster + cloud node" title="Proxmox · PBS / ZFS / Wasabi" scroll={true}>
            <ProxmoxBackupFlow />
            <Fragment slot="legend">
              <span class="inline-flex items-center gap-1.5">
                ZFS replication = warm standby · PBS = incremental, deduplicated, encrypted
              </span>
            </Fragment>
          </DiagramFrame>
        </div>

        <!-- Hyper-V / Veeam -->
        <div class="mt-10 reveal">
          <DiagramFrame tone="amber" eyebrow="Hyper-V lab" title="Veeam · image backups → Wasabi" scroll={true}>
            <VeeamBackupFlow />
            <Fragment slot="legend">
              <span class="inline-flex items-center gap-1.5">
                full daily images + incrementals · hot ~45 days · aged points offload to Wasabi
              </span>
            </Fragment>
          </DiagramFrame>
        </div>

        <!-- Encryption -->
        <div class="mt-10 reveal">
          <DiagramFrame tone="emerald" eyebrow="Client-side + at rest" title="How the Encryption Works" scroll={true}>
            <BackupEncryptionFlow />
            <Fragment slot="legend">
              <span class="inline-flex items-center gap-1.5">
                <span class="inline-block w-6 border-t border-dashed border-slate"></span>
                dotted = key never leaves the host · provider stores ciphertext only
              </span>
            </Fragment>
          </DiagramFrame>
        </div>

        <div class="space-y-4 text-slate leading-relaxed max-w-3xl mx-auto mt-10">
          <p>
            The <span class="text-accent font-semibold">Arch daily driver</span> runs btrfs with a flat subvolume
            layout, and <span class="text-accent font-semibold">snapper</span> keeps an automated ~30-day window of
            local snapshots. Pre/post-pacman and timeline snapshots make a bad upgrade a one-command
            rollback. A systemd-timed <span class="text-accent font-semibold">restic</span> job then takes encrypted,
            file-level copies of <span class="text-accent font-semibold">/home</span> and
            <span class="text-accent font-semibold">/data</span> to a Synology NAS, which HyperBackup mirrors offsite
            to Wasabi.
          </p>
          <p>
            The <span class="text-accent font-semibold">Proxmox cluster</span> leans on
            <span class="text-accent font-semibold">Proxmox Backup Server</span> for incremental, deduplicated,
            client-encrypted guest backups, with ZFS replication between nodes for warm standby; PBS and the
            offsite cloud PVE node both sync to Wasabi. The <span class="text-accent font-semibold">Hyper-V lab</span>
            uses <span class="text-accent font-semibold">Veeam</span> for application-consistent full image backups
            daily plus incrementals, kept hot locally for ~45 days before older restore points age out to a
            Wasabi capacity tier.
          </p>
          <p>
            Privacy is non-negotiable: <span class="text-accent font-semibold">restic</span> and
            <span class="text-accent font-semibold">Veeam</span> encrypt client-side, so keys never leave the host and
            only ciphertext crosses the wire. Wasabi adds its own encryption at rest and stores everything
            deduplicated. The provider never holds a key or sees plaintext.
          </p>
        </div>
      </div>
    </section>

    <!-- ── RAID & Redundancy ───────────────────────────────────────── -->
    <section id="raid" class="section py-16 bg-navy-light/30">
      <div class="container-narrow">
        <div class="mb-8 text-center">
          <h2 class="text-2xl md:text-3xl font-bold text-slate-light mb-2">
            <span class="text-emerald-light">⟨</span> RAID &amp; Redundancy <span class="text-emerald-light">⟩</span>
          </h2>
          <p class="text-slate max-w-2xl mx-auto">
            Redundancy is the first line of defense. It keeps data online when a disk dies, before any
            backup is needed. Every tier is built to lose drives without losing data, all of it
            checksummed and scrubbed against silent corruption.
          </p>
        </div>

        <!-- Redundancy tiers -->
        <div class="reveal">
          <DiagramFrame tone="emerald" eyebrow="Built to lose disks" title="Storage Redundancy Tiers" scroll={true}>
            <RaidRedundancyFlow />
            <Fragment slot="legend">
              <span class="inline-flex items-center gap-1.5">
                <span class="inline-block w-3 h-3 rounded-sm" style="background:#fbbf24"></span>
                parity (RAIDZ2)
              </span>
              <span class="inline-flex items-center gap-1.5">
                <span class="inline-block w-3 h-3 rounded-sm" style="background:#22d3ee"></span>
                mirror (RAID1)
              </span>
              <span class="inline-flex items-center gap-1.5">
                <span class="inline-block w-3 h-3 rounded-sm" style="background:#34d399"></span>
                SHR / btrfs
              </span>
            </Fragment>
          </DiagramFrame>
        </div>

        <div class="space-y-4 text-slate leading-relaxed max-w-3xl mx-auto mt-10">
          <p>
            The primary storage host runs a <span class="text-accent font-semibold">RAIDZ2</span> pool with ZFS
            double parity, so it can lose <span class="text-accent font-semibold">two drives at once</span> and
            stay online, which matters most on the wide, high-capacity vdevs where a second disk can fail
            during a rebuild. The rest of the cluster runs <span class="text-accent font-semibold">ZFS mirrors
            (RAID1)</span>: each vdev keeps a full copy, so a failed drive resilvers fast from its twin
            with minimal performance hit, the right trade for the smaller NVMe pools backing VMs.
          </p>
          <p>
            The <span class="text-accent font-semibold">Synology NAS</span> uses
            <span class="text-accent font-semibold">SHR (Synology Hybrid RAID)</span> with btrfs under the hood, which
            adds flexible redundancy across <span class="text-accent font-semibold">mixed-size drives</span> (no
            wasted capacity from matching the smallest disk) plus btrfs block checksums and self-healing.
            Across all three, <span class="text-accent font-semibold">ZFS and btrfs checksum every block</span> and
            scheduled scrubs catch and repair bit rot before it spreads. Redundancy isn't a substitute for
            the 3-2-1 backups above. It's what keeps everything serving while a disk gets replaced.
          </p>
        </div>
      </div>
    </section>

