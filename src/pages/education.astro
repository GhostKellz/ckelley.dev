---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navigation from '@components/Navigation.astro';
import PageHero from '@components/PageHero.astro';
import SectionHeading from '@components/SectionHeading.astro';
import '@styles/global.css';

const certifications = [
  { name: 'CompTIA Security+', code: 'SY0-701', year: '2024', color: '#c8102e' },
  { name: 'CompTIA Network+', code: 'N10-008', year: '2024', color: '#c8102e' },
  { name: 'CompTIA Linux+', code: 'XK0-005', year: '2024', color: '#c8102e' },
  { name: 'Cisco CCNA', code: '200-301', year: '2024', color: '#1ba0d7' },
];

const courses = [
  {
    code: 'IT 489',
    name: 'IT Capstone',
    description: 'Capstone project integrating SD-WAN, Fortinet firewalls, Tailscale VPN, and Azure cloud infrastructure.',
    highlights: ['F-Secure System Design', 'Enterprise Architecture', 'Security Framework'],
  },
  {
    code: 'IT 420',
    name: 'Enterprise Architecture',
    description: 'Enterprise-level IT infrastructure design, network architecture, and security framework implementation.',
    highlights: ['Network Design', 'SD-WAN Architecture', 'Security Planning'],
  },
  {
    code: 'CS 360',
    name: 'Mobile Development',
    description: 'Android application development with Java, SQLite databases, and Material Design.',
    highlights: ['Event Tracking App', 'Java/Android', 'SQLite'],
  },
  {
    code: 'DAD 220',
    name: 'Database Administration',
    description: 'Relational database design, SQL optimization, and data modeling with MySQL.',
    highlights: ['ERD Design', 'Complex SQL', 'Data Modeling'],
  },
  {
    code: 'CS 250',
    name: 'Software Development Lifecycle',
    description: 'Agile methodology, user stories, test case design, and iterative development.',
    highlights: ['Agile/Scrum', 'Test Cases', 'SDLC'],
  },
  {
    code: 'IT 331',
    name: 'Network Security',
    description: 'Network security principles, firewall configuration, and threat mitigation.',
    highlights: ['Firewalls', 'Threat Analysis', 'Security Policies'],
  },
];

const academicProjects = [
  { name: 'Event Tracking App', course: 'CS 360 / Mobile Development', description: 'An Android application written in Java with SQLite storage, user authentication, an event grid, and SMS reminders.', lesson: 'I reduced an ambitious calendar interface to a focused GridView that I could finish and polish. Scoping the work was as important as implementing it.', href: 'https://github.com/GhostKellz/EventTrackingApp' },
  { name: 'Quantigration RMA Database', course: 'DAD 220 / Database Administration', description: 'A relational schema connecting customers, orders, and returns, supported by an ERD and MySQL queries for return analysis.', lesson: 'Joins and aggregations turned transaction records into useful summaries, connecting database design to the questions a stakeholder needs answered.' },
  { name: 'Travel Planning Application', course: 'CS 250 / Software Development Lifecycle', description: 'A team project using Scrum, user stories, test cases, a JIRA backlog, and GitHub version control.', lesson: 'A change in product direction required revised stories and tests. The exercise made the relationship between requirements, scope, and validation concrete.' },
];
---

<BaseLayout title="Education | Christopher Kelley" description="Software development education at SNHU, industry certifications, and practical projects in application development, networking, and infrastructure.">
  <Navigation />
  <main class="pt-24 portfolio-page">
    <PageHero eyebrow="Education" title="A technical foundation." accent="Applied through building."
      description="A B.S. in Software Development from Southern New Hampshire University, complemented by certifications in networking, security, and Linux. The practical work connects directly to the systems and software I build today."
      links={[{ id: 'degree', label: 'Degree' }, { id: 'certifications', label: 'Certifications' }, { id: 'capstone', label: 'Capstone' }, { id: 'academic-projects', label: 'Projects' }, { id: 'coursework', label: 'Coursework' }]} />

    <section id="degree" class="section bg-navy-light/30">
      <div class="container-narrow">
        <SectionHeading eyebrow="Southern New Hampshire University / 2019–2023" title="Bachelor of Science." accent="Software Development." description="Software engineering, databases, mobile development, and infrastructure, bringing programming fundamentals together with practical IT operations." />
        <div class="flex flex-wrap gap-2">
          {['Software Engineering', 'Database Design', 'Java / C++ / Python', 'Network Security', 'Agile / SDLC', 'Enterprise Architecture'].map(skill => <span class="portfolio-tag">{skill}</span>)}
        </div>
      </div>
    </section>

    <section id="certifications" class="section">
      <div class="container-narrow">
        <SectionHeading eyebrow="Industry credentials" title="Grounded in" accent="systems and security." description="Certifications earned across network administration, Linux operations, and security fundamentals." />
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {certifications.map(cert => (
            <article class="card border-t-2 border-t-accent-muted">
              <h3>{cert.name}</h3>
              <p class="text-accent font-mono text-sm mt-3">{cert.code}</p>
              <p class="portfolio-copy mt-2">Earned {cert.year}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="capstone" class="section bg-navy-light/30">
      <div class="container-narrow">
        <SectionHeading eyebrow="Featured case study / IT 420 & IT 489" title="From a design brief" accent="to a working lab." description="F-Secure System Design: an academic infrastructure project for a fictional company, followed by hands-on implementation in my own lab." />
        <div class="grid md:grid-cols-2 gap-4">
          <article class="card"><p class="section-eyebrow">01 / The brief</p><h3>Plan a secure expansion</h3><p class="portfolio-copy mt-3">Design an environment that brings together multiple sites, remote access, cloud services, and centralized security. The assignment connected enterprise architecture with network and security planning.</p></article>
          <article class="card"><p class="section-eyebrow">02 / The design</p><h3>Connect the infrastructure</h3><p class="portfolio-copy mt-3">The design combined SD-WAN, FortiGate firewalls, Tailscale remote access, and Azure services. VLAN segmentation, inspection policies, and centralized logging supported the network design.</p></article>
          <article class="card"><p class="section-eyebrow">03 / The implementation</p><h3>Test it in the lab</h3><p class="portfolio-copy mt-3">I took the work beyond the design document, using real FortiGate hardware, Tailscale networking, and Azure to explore the proposed setup. The lab made configuration and compatibility questions tangible.</p></article>
          <article class="card"><p class="section-eyebrow">04 / The lesson</p><h3>Validate the connections</h3><p class="portfolio-copy mt-3">The project brought software lifecycle fundamentals together with networking and operations. Building the environment helped me understand the gap between a diagram and a system that can be configured, observed, and maintained.</p></article>
        </div>
        <a href="/lab" class="link inline-block mt-6">See how that work continues in the lab →</a>
      </div>
    </section>

    <section id="academic-projects" class="section">
      <div class="container-narrow">
        <SectionHeading eyebrow="Selected academic work" title="Build something." accent="Learn from the decisions." description="Application development, database design, and team delivery each taught a different part of the engineering process." />
        <div class="grid lg:grid-cols-3 gap-4">
          {academicProjects.map(project => (
            <article class="card flex flex-col">
              <p class="section-eyebrow">{project.course}</p>
              <h3>{project.name}</h3>
              <p class="portfolio-copy mt-3">{project.description}</p>
              <p class="portfolio-copy mt-4 pt-4 border-t border-slate-dark/40 grow"><strong class="text-accent">What I learned:</strong> {project.lesson}</p>
              {project.href && <a href={project.href} class="link mt-5" target="_blank" rel="noopener noreferrer">View the code ↗</a>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="coursework" class="section bg-navy-light/30">
      <div class="container-narrow">
        <SectionHeading eyebrow="Coursework" title="The supporting" accent="fundamentals." />
        <div class="grid md:grid-cols-2 gap-x-10">
          {courses.map(course => (
            <article class="py-5 border-t border-slate-dark/40">
              <p class="text-accent font-mono text-xs mb-2">{course.code}</p>
              <h3 class="text-lg font-semibold">{course.name}</h3>
              <p class="portfolio-copy mt-2">{course.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section class="section text-center"><div class="container-narrow"><h2 class="section-title">See the work <span>that followed.</span></h2><p class="section-description mb-6">Explore the software and infrastructure projects I build today.</p><a href="/projects" class="btn btn-primary">View Projects →</a></div></section>
  </main>
  <footer class="py-8 text-center"><a href="/" class="link text-sm font-mono">← Back to Home</a></footer>
</BaseLayout>
