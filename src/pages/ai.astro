---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navigation from '@components/Navigation.astro';
import AIWorkflowDiagram from '@components/diagram/AIWorkflowDiagram.astro';
import '@styles/global.css';

const hardware = [
  {
    name: 'RTX 5090',
    spec: 'Blackwell · 32 GB VRAM',
    role: 'Primary workstation GPU for daily inference, image and video generation, and testing local AI workflows.',
    label: 'Daily workstation',
  },
  {
    name: 'RTX 4090',
    spec: '24 GB VRAM · Proxmox',
    role: 'A second daily-use GPU, passed through to a Proxmox VM for inference and GPU workloads alongside the workstation.',
    label: 'Dedicated GPU workloads',
  },
  {
    name: '2× DGX Spark',
    spec: 'GB10 · 200 Gb/s interconnect',
    role: 'Two GB10 systems with 128 GB unified memory each. The primary serves the vLLM API and coordinates distributed inference with the worker.',
    label: 'Cluster compute',
  },
];

const serving = [
  { name: 'vLLM', description: 'Local LLM inference and API serving, including workloads on the DGX Spark cluster.' },
  { name: 'SGLang', description: 'An additional serving engine in my daily stack for running and evaluating local language models.' },
  { name: 'CUDA', description: 'The GPU compute foundation for inference and generative workloads across the NVIDIA systems.' },
];

const agents = [
  { name: 'Hermes Agent', description: 'The orchestration layer for agent work, bringing together models, tools, memory, and reusable skills.' },
  { name: 'OpenShell', description: 'Policy-controlled execution environments for agent tools and workloads.' },
  { name: 'OpenClaw', description: 'An additional assistant and agent environment for coding and automation tasks.' },
];

const development = [
  { name: 'Claude Code', description: 'Daily development work across repositories, from implementation to debugging and review.' },
  { name: 'Codex', description: 'Coding and review alongside Claude Code, including second opinions on implementation decisions.' },
  { name: 'OpenCode', description: 'A coding interface for working with local model endpoints and hosted providers.' },
];

const sections = [
  { id: 'compute', label: 'Compute' },
  { id: 'serving', label: 'Model serving' },
  { id: 'request-path', label: 'Request path' },
  { id: 'creative', label: 'Image & video' },
  { id: 'orchestration', label: 'Orchestration' },
  { id: 'development', label: 'Development' },
  { id: 'automation', label: 'Automation' },
];
---

<BaseLayout title="AI Infrastructure | Christopher Kelley" description="My daily AI stack: RTX 5090, RTX 4090, a two-node DGX Spark cluster, vLLM and SGLang model serving, ComfyUI image and video generation, and Hermes agent orchestration.">
  <Navigation />
  <main class="pt-24 ai-page">
    <section class="section ai-hero">
      <div class="container-narrow">
        <p class="eyebrow">AI Infrastructure</p>
        <h1>Local compute.<br /><span class="text-gradient">Connected intelligence.</span></h1>
        <p class="hero-description">
          My daily AI stack spans an RTX 5090, RTX 4090, and a two-node DGX Spark cluster.
          Local model serving, image and video generation, and Hermes orchestration,
          with cloud models available for the work that benefits from them.
        </p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="/architecture" class="btn btn-primary">Explore the Architecture <span class="ml-2" aria-hidden="true">→</span></a>
          <a href="/lab" class="btn btn-secondary">Inside the Lab</a>
        </div>
        <nav aria-label="AI page sections" class="section-links">
          {sections.map(section => <a href={`#${section.id}`}>{section.label}<span aria-hidden="true"> ↗</span></a>)}
          <a href="/architecture#spark-cluster">DGX Spark Cluster<span aria-hidden="true"> ↗</span></a>
        </nav>
      </div>
    </section>

    <section id="compute" class="section bg-navy-light/30" aria-labelledby="compute-title">
      <div class="container-narrow">
        <header class="section-header">
          <p class="eyebrow">01 / Compute</p>
          <h2 id="compute-title">The hardware <span>behind the work.</span></h2>
          <p>Three primary systems for everyday inference, creative workloads, and cluster experimentation.</p>
        </header>
        <p class="portfolio-copy max-w-3xl mb-8">The workstation, dedicated GPU VM, and Spark cluster give me different places to run and experiment with workloads. I treat them as distinct compute resources, with model size and the task guiding placement. That keeps the hardware overview tied to how I use the systems, from a local generation workflow to serving a model for an agent.</p>
        <div class="grid md:grid-cols-3 gap-4">
          {hardware.map(hw => (
            <article class="card compute-card">
              <p class="card-label">{hw.label}</p>
              <h3>{hw.name}</h3>
              <p class="text-accent text-sm font-mono mt-2 mb-4">{hw.spec}</p>
              <p class="card-copy">{hw.role}</p>
            </article>
          ))}
        </div>
        <p class="supporting-note">The Sparks communicate over a dedicated <strong class="text-accent">200 Gb/s ConnectX-7 link</strong> for distributed inference. Their 256 GB of aggregate unified memory remains split between two nodes, with the serving configuration distributing the work. <a href="/architecture#spark-cluster" class="link">See how the cluster connects →</a></p>
        <p class="supporting-note">Additional lab capacity includes an RTX 3080, RTX 3070, and two RTX 2060s for smaller workloads and testing. <a href="/lab" class="link">See the wider lab →</a></p>
      </div>
    </section>

    <section id="serving" class="section" aria-labelledby="serving-title">
      <div class="container-narrow">
        <header class="section-header">
          <p class="eyebrow">02 / Model Serving</p>
          <h2 id="serving-title">Local models. <span>Useful endpoints.</span></h2>
          <p>vLLM and SGLang are the focus of my serving stack, making local models available to the tools and agents I use.</p>
        </header>
        <div class="grid md:grid-cols-3 gap-4">
          {serving.map(tool => (
            <article class="card">
              <h3>{tool.name}</h3>
              <p class="card-copy mt-3">{tool.description}</p>
            </article>
          ))}
        </div>
        <p class="supporting-note">Model choice and placement depend on memory requirements, workload, and the capabilities each client needs. Keeping both vLLM and SGLang in the stack gives me room to evaluate the serving layer alongside the model. For an agent, that includes how the client interacts with the endpoint; for interactive work, it includes how usable the response feels. Local endpoints and cloud providers both have a place in the setup.</p>
      </div>
    </section>

    <section id="request-path" class="section bg-navy-light/30" aria-labelledby="request-title">
      <div class="container-narrow">
        <header class="section-header">
          <p class="eyebrow">03 / The Request Path</p>
          <h2 id="request-title">One gateway. <span>The right backend.</span></h2>
          <p>Hermes, Open WebUI, and development clients send model requests through LiteLLM. The gateway routes the request to a configured inference endpoint, including the primary node of the Spark pair.</p>
        </header>
        <figure class="workflow-frame">
          <AIWorkflowDiagram kind="overview" />
          <figcaption class="supporting-note">The centralized vLLM request path. Responses return to the calling client; the available endpoints depend on the models currently loaded.</figcaption>
        </figure>
        <div class="grid md:grid-cols-2 gap-6 mt-8">
          <div><h3>LiteLLM routes the request</h3><p class="card-copy mt-3">Named model routes give clients a consistent entry point while keeping serving separate from the interface. GPU execution stays on the backend; the gateway handles model access and routing.</p></div>
          <div><h3>Hermes manages the work</h3><p class="card-copy mt-3">Hermes combines the instructions, memory, and tools around each model call. A response can inform the next step, while configured permissions and approvals control tool execution. Results become context for the next iteration.</p></div>
        </div>
        <a href="/architecture#ai" class="link inline-block mt-6">Explore the gateway, Spark interconnect, and agent loop →</a>
      </div>
    </section>

    <section id="creative" class="section bg-navy-light/30" aria-labelledby="creative-title">
      <div class="container-narrow grid lg:grid-cols-2 gap-8 lg:gap-12 items-start">
        <header class="section-header">
          <p class="eyebrow">04 / Image & Video</p>
          <h2 id="creative-title">From a prompt <span>to a visual workflow.</span></h2>
          <p>Image and video generation are part of my daily GPU use, alongside language models and coding agents.</p>
        </header>
        <article class="card creative-card">
          <p class="card-label">Creative tooling</p>
          <h3>ComfyUI</h3>
          <p class="card-copy mt-3">I use ComfyUI for image and video generation, working with node-based workflows to connect models and generation steps, adjust settings, and iterate on outputs.</p>
          <p class="card-copy mt-4">The workflow itself is part of the work: it records how the generation steps fit together and gives me a starting point for the next iteration. That makes it easier to explore a visual direction, revisit the setup, and adjust individual stages as I work toward an output.</p>
          <div class="flex flex-wrap gap-2 mt-6" aria-label="ComfyUI workloads">
            <span class="workload-tag">Image generation</span>
            <span class="workload-tag">Video generation</span>
            <span class="workload-tag">Workflow iteration</span>
          </div>
        </article>
      </div>
    </section>

    <section id="orchestration" class="section" aria-labelledby="orchestration-title">
      <div class="container-narrow">
        <header class="section-header">
          <p class="eyebrow">05 / Agent Orchestration</p>
          <h2 id="orchestration-title">Hermes connects <span>models to tools.</span></h2>
          <p>The agent layer brings instructions, memory, and tool use together. Hermes is central to how I orchestrate that work across local and cloud models.</p>
        </header>
        <div class="grid md:grid-cols-3 gap-4">
          {agents.map(tool => (
            <article class="card">
              <h3>{tool.name}</h3>
              <p class="card-copy mt-3">{tool.description}</p>
            </article>
          ))}
        </div>
        <p class="supporting-note">Reusable skills capture procedures that are worth repeating. I think about the orchestration layer in terms of the instructions an agent receives, the tools it can call, and the context it needs to continue useful work. The model is one part of that setup. Model selection can change with the task, while the surrounding tools, skills, and workflows remain the focus.</p>
      </div>
    </section>

    <section id="development" class="section bg-navy-light/30" aria-labelledby="development-title">
      <div class="container-narrow">
        <header class="section-header">
          <p class="eyebrow">06 / Development</p>
          <h2 id="development-title">AI in the <span>development loop.</span></h2>
          <p>Coding tools I use to implement changes, investigate problems, and review work across my projects.</p>
        </header>
        <div class="grid md:grid-cols-3 gap-4">
          {development.map(tool => (
            <article class="card">
              <h3>{tool.name}</h3>
              <p class="card-copy mt-3">{tool.description}</p>
            </article>
          ))}
        </div>
        <a href="/projects" class="link inline-block mt-6">Explore my projects →</a>
      </div>
    </section>

    <section id="automation" class="section" aria-labelledby="automation-title">
      <div class="container-narrow grid lg:grid-cols-2 gap-8 lg:gap-12 items-start">
        <header class="section-header">
          <p class="eyebrow">07 / Workflow Automation</p>
          <h2 id="automation-title">Connect the steps. <span>Repeat the useful work.</span></h2>
          <p>n8n connects models and services to the events and schedules that make a workflow useful beyond a single session.</p>
        </header>
        <article class="card">
          <h3>n8n</h3>
          <p class="card-copy mt-3">I use n8n to connect APIs, call models, transform results, and pass them to the next service. It provides the workflow layer alongside Hermes agent orchestration.</p>
          <p class="card-copy mt-4">The focus is on repeatable integrations and background jobs, with local or cloud inference selected for each workflow.</p>
        </article>
      </div>
    </section>

    <section class="section bg-navy-light/30 text-center">
      <div class="container-narrow">
        <header class="section-header mx-auto">
          <p class="eyebrow">Put it to work</p>
          <h2>Build your <span>AI workflow.</span></h2>
          <p>From local model serving to image generation and connected automation, I can help design the infrastructure and integrations around your work.</p>
        </header>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/#contact" class="btn btn-primary">Get In Touch</a>
          <a href="/technologies" class="btn btn-secondary">View Technologies</a>
        </div>
      </div>
    </section>
  </main>
  <footer class="py-8 text-center">
    <p class="text-slate text-sm font-mono"><a href="/" class="link">← Back to Home</a></p>
  </footer>
</BaseLayout>

<style>
  .workflow-frame { background:var(--color-navy); border:1px solid var(--color-slate-dark); border-radius:0.75rem; padding:1rem; }
  .ai-page section[id] { scroll-margin-top: 6rem; }
  .ai-hero { padding-top: 4rem; padding-bottom: 3rem; background: radial-gradient(ellipse at 85% 15%, rgb(100 255 218 / 7%), transparent 60%); }
  .eyebrow { color: var(--color-accent); font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 1rem; }
  h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 800; line-height: 1.08; letter-spacing: -0.045em; text-wrap: balance; }
  .hero-description { max-width: 44rem; margin-top: 1.5rem; color: var(--color-slate-light); font-size: 1.125rem; line-height: 1.8; }
  .section-header { max-width: 46rem; margin-bottom: 2rem; }
  h2 { color: var(--color-slate-light); font-size: clamp(1.875rem, 3.5vw, 2.75rem); font-weight: 750; letter-spacing: -0.035em; line-height: 1.18; text-wrap: balance; }
  h2 span { color: var(--color-accent); }
  .section-header > p:last-child:not(.eyebrow) { color: var(--color-slate-light); opacity: 0.85; font-size: 1.0625rem; line-height: 1.75; margin-top: 1rem; }
  h3 { color: var(--color-slate-light); font-size: 1.25rem; font-weight: 700; letter-spacing: -0.02em; }
  .compute-card h3, .creative-card h3 { font-size: 1.75rem; }
  .compute-card { border-top: 2px solid var(--color-accent-muted); }
  .card-label { color: var(--color-accent); font-family: var(--font-mono); font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1rem; }
  .card-copy { color: var(--color-slate-light); opacity: 0.85; font-size: 0.9375rem; line-height: 1.75; }
  .supporting-note { color: var(--color-slate); font-size: 0.9375rem; line-height: 1.75; margin-top: 1.5rem; max-width: 49rem; }
  .section-links { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-slate-dark); }
  .section-links a, .workload-tag { padding: 0.5rem 0.75rem; border: 1px solid rgb(100 255 218 / 20%); border-radius: 0.375rem; font-size: 0.8125rem; color: var(--color-slate-light); }
  .section-links a:hover { color: var(--color-accent); border-color: var(--color-accent); background: rgb(100 255 218 / 5%); }
  .ai-page a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 5px; }
  @media (prefers-reduced-motion: reduce) { .card { transition: none; } .card:hover { transform: none; } }
</style>
