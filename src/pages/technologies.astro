const groupsOf = (category: Category): TechGroup[] =>
  category.groups ?? [{ label: '', technologies: category.technologies ?? [] }];

const techCount = categories.flatMap(groupsOf).flatMap(group => group.technologies).length;
---

<BaseLayout title="Technologies | Christopher Kelley" description="Technologies I use across DevOps, enterprise IT, AI workloads, software development, networking, and security.">
  <Navigation />
  <main class="pt-24 portfolio-page">
    <PageHero eyebrow="Technologies" title="The tools behind" accent="the work."
      description="Technologies I use to build, automate, and operate infrastructure, from enterprise IT and cloud services to software development and AI workloads."
      links={categories.map(category => ({ id: category.id, label: category.title }))}>
      <dl class="flex flex-wrap gap-x-10 gap-y-5 mt-8">
        <div><dt class="text-slate text-sm">Technologies</dt><dd class="text-2xl font-bold text-accent mt-1">{techCount}</dd></div>
        <div><dt class="text-slate text-sm">Years of experience</dt><dd class="text-2xl font-bold text-accent mt-1">7+</dd></div>
        <div><dt class="text-slate text-sm">M365 users managed</dt><dd class="text-2xl font-bold text-accent mt-1">100s</dd></div>
      </dl>
    </PageHero>
    <div class="container-narrow px-6 py-8">
      <label for="technology-search" class="block font-semibold mb-3">Find a technology or capability</label>
      <input id="technology-search" type="search" placeholder="Try Docker, backups, or authentication" class="w-full max-w-xl bg-navy-light text-slate-light border border-slate-dark rounded-md px-4 py-3" />
      <p id="technology-results" role="status" class="text-slate text-sm mt-3">{techCount} technologies across {categories.length} categories</p>
    </div>
    <p id="technology-empty" hidden class="container-narrow px-6 py-8 text-slate-light">No matches. Try another name or capability, or clear the search to browse all categories.</p>
    {categories.map((category, index) => (
      <section id={category.id} data-tech-category class={`section ${index % 2 === 0 ? 'bg-navy-light/30' : ''}`}>
        <div class="container-narrow">
          <SectionHeading eyebrow={`Domain ${String(index + 1).padStart(2, '0')}`} title={category.title.split(' & ')[0]} accent={category.title.includes(' & ') ? `& ${category.title.split(' & ')[1]}` : undefined} description={category.description}>
            {category.link && <a href={category.link.href} class="link inline-block mt-3">{category.link.label} →</a>}
          </SectionHeading>
          {groupsOf(category).map(group => (
            <div data-tech-group class="mb-6 last:mb-0">
              {group.label && <h3 class="section-eyebrow">{group.label}</h3>}
              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-3">
                {group.technologies.map(tech => (
                  <article class="card py-5 px-5" data-tech-search={`${tech.name} ${tech.description} ${category.title} ${group.label}`.toLowerCase()}>
                    {group.label ? <h4 class="font-semibold text-slate-light text-lg mb-2">{tech.name}</h4> : <h3 class="mb-2">{tech.name}</h3>}
                    <p class="portfolio-copy">{tech.description}</p>
                  </article>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
    <section class="section text-center"><div class="container-narrow"><h2 class="section-title">See these tools <span>in practice.</span></h2><p class="section-description mb-6">Explore the projects and infrastructure behind the technology list.</p><div class="flex flex-wrap justify-center gap-4"><a href="/projects" class="btn btn-primary">View Projects</a><a href="/lab" class="btn btn-secondary">Explore the Lab</a></div></div></section>
  </main>
  <footer class="py-8 text-center"><a href="/" class="link text-sm font-mono">← Back to Home</a></footer>
</BaseLayout>
<script>
  const search = document.querySelector<HTMLInputElement>('#technology-search');
  const updateTechnologies = () => {
    const words = (search?.value.trim().toLowerCase() ?? '').split(/\s+/).filter(Boolean);
    let count = 0;
    let categories = 0;
    document.querySelectorAll<HTMLElement>('[data-tech-search]').forEach(card => {
      card.hidden = !words.every(word => card.dataset.techSearch?.includes(word));
      if (!card.hidden) count++;
    });
    document.querySelectorAll<HTMLElement>('[data-tech-group], [data-tech-category]').forEach(group => {
      group.hidden = !group.querySelector('[data-tech-search]:not([hidden])');
      if (group.hasAttribute('data-tech-category') && !group.hidden) categories++;
    });
    const status = document.querySelector('#technology-results');
    if (status) status.textContent = `${count} ${count === 1 ? 'technology' : 'technologies'} across ${categories} ${categories === 1 ? 'category' : 'categories'}`;
    const empty = document.querySelector<HTMLElement>('#technology-empty');
    if (empty) empty.hidden = count !== 0;
  };
  search?.addEventListener('input', updateTechnologies);
  document.querySelectorAll<HTMLAnchorElement>('.page-jumps a').forEach(link => {
    link.addEventListener('click', () => { if (search) { search.value = ''; updateTechnologies(); } });
  });
</script>
