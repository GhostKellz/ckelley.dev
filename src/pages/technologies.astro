  },
  {
    title: 'DevOps & Self-Hosting',
    icon: '🐳',
    description: 'Containerization, CI/CD, and self-hosted infrastructure.',
    technologies: [
      { name: 'Docker', description: 'Container runtime for all self-hosted services' },
      { name: 'Docker Compose', description: 'Multi-container application orchestration' },
      { name: 'Self-Hosted CI Runners', description: 'GitLab and GitHub Actions runners on own infrastructure' },
      { name: 'NGINX', description: 'Reverse proxy, load balancing, and SSL termination' },
      { name: 'Traefik', description: 'Cloud-native reverse proxy with automatic SSL' },
      { name: 'GitLab', description: 'Self-hosted Git, CI/CD pipelines, and container registry' },
    ],
  },
  {
    title: 'AI & Automation',
    icon: '🤖',
    description: 'Local AI infrastructure and automation tooling.',
    technologies: [
      { name: 'Ollama', description: 'Native CUDA LLM hosting on RTX 5090 (Blackwell) with flash attention and 64k context' },
      { name: 'vLLM', description: 'High-throughput LLM inference & serving across local/cluster GPUs' },
      { name: 'Hermes Agent', description: 'Nous Research autonomous agent that persists memory and self-writes reusable skills' },
      { name: 'OpenShell', description: 'NVIDIA sandboxed, policy-governed runtimes for autonomous AI agents' },
      { name: 'OpenClaw', description: 'Personal AI assistant and coding agent' },
      { name: 'Bash/Zsh', description: 'Shell scripting for automation and system administration' },
      { name: 'n8n', description: 'Workflow automation and integration platform' },
      { name: 'Ansible', description: 'Infrastructure as code and configuration management' },
      { name: 'Terraform', description: 'Cloud infrastructure provisioning' },
      { name: 'PowerShell', description: 'Windows automation and scripting' },
    ],
  },
  {
    title: 'Web Hosting & DNS',
    icon: '🌐',
    description: 'Domain management, web servers, and CDN.',
    technologies: [
      { name: 'Cloudflare', description: 'DNS, CDN, DDoS protection, and zero-trust tunnels' },
      { name: 'NGINX', description: 'Web server for static sites and reverse proxy' },
      { name: 'HestiaCP', description: 'Open-source web hosting control panel' },
      { name: 'ACME / Let\'s Encrypt', description: 'Automated TLS certificate issuance and renewal via the ACME protocol' },
      { name: 'Astro', description: 'Modern static site generator (this site!)' },
      { name: 'WordPress', description: 'CMS management and migration' },
    ],
  },
  {
    title: 'Development Tools',
    icon: '⌨️',
    description: 'Editor, version control, and development environment.',
    technologies: [
      { name: 'Neovim', description: 'Primary editor with custom Lua configuration' },
      { name: 'Git', description: 'Version control for all projects' },
      { name: 'GitHub', description: 'Code hosting and CI/CD workflows' },
      { name: 'Rust', description: 'Systems programming for CLI tools' },
      { name: 'Zig', description: 'Low-level systems programming and libraries' },
      { name: 'Python', description: 'Scripting and automation' },
    ],
  },
];
---

<BaseLayout title="Technologies | Christopher Kelley" description="IT and MSP technology stack - virtualization, Microsoft 365, networking, security, and DevOps expertise.">
  <Navigation />

  <main class="pt-24">
    <!-- Hero -->
    <section class="section pb-12">
      <div class="container-narrow text-center">
        <p class="heading-accent">Expertise</p>
        <h1 class="text-4xl md:text-5xl font-bold text-slate-light mb-4">Technologies</h1>
        <p class="text-slate max-w-2xl mx-auto">
          From enterprise Microsoft 365 deployments to self-hosted infrastructure,
          here's the technology stack I work with daily to deliver IT solutions.
        </p>
      </div>
    </section>

    <!-- Quick Stats -->
    <section class="section py-12 bg-navy-light/30">
      <div class="container-narrow">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
          <div class="card py-6">
            <p class="text-3xl font-bold text-accent mb-1">50+</p>
            <p class="text-slate text-sm">Technologies</p>
          </div>
          <div class="card py-6">
            <p class="text-3xl font-bold text-accent mb-1">5+</p>
            <p class="text-slate text-sm">Years Experience</p>
          </div>
          <div class="card py-6">
            <p class="text-3xl font-bold text-accent mb-1">100s</p>
            <p class="text-slate text-sm">M365 Users Managed</p>
          </div>
          <div class="card py-6">
            <p class="text-3xl font-bold text-accent mb-1">24/7</p>
            <p class="text-slate text-sm">Homelab Uptime</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Technology Categories -->
    {categories.map((category, index) => (
      <section class={`section py-16 ${index % 2 === 0 ? '' : 'bg-navy-light/30'}`}>
        <div class="container-narrow">
          <div class="flex items-center gap-3 mb-6">
            <span class="text-3xl">{category.icon}</span>
            <div>
              <h2 class="text-xl md:text-2xl font-bold text-slate-light">
                {category.title}
              </h2>
              <p class="text-slate text-sm">{category.description}</p>
            </div>
          </div>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-3">
            {category.technologies.map(tech => (
              <div class="card py-4 px-5 hover:border-accent/30">
                <h3 class="font-semibold text-slate-light text-sm mb-1">{tech.name}</h3>
                <p class="text-slate text-xs leading-relaxed">{tech.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    ))}

    <!-- CTA -->
    <section class="section text-center">
      <div class="container-narrow">
        <h2 class="text-2xl font-bold text-slate-light mb-4">Need IT Consulting?</h2>
        <p class="text-slate mb-6 max-w-xl mx-auto">
          Whether it's Microsoft 365 migration, infrastructure design, or security hardening,
          I can help your business succeed.
        </p>
        <div class="flex justify-center gap-4">
          <a href="/#contact" class="btn btn-primary">
            Get In Touch
          </a>
          <a href="/projects" class="btn btn-secondary">
            View Projects
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="py-8 text-center">
    <p class="text-slate text-sm font-mono">
      <a href="/" class="text-accent hover:underline">← Back to Home</a>
    </p>
  </footer>
</BaseLayout>
