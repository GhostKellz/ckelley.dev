---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navigation from '@components/Navigation.astro';
import '@styles/global.css';

interface Tech {
  name: string;
  description: string;
}

interface Category {
  title: string;
  icon: string;
  description: string;
  technologies: Tech[];
}

const categories: Category[] = [
  {
    title: 'Virtualization & Infrastructure',
    icon: '🖥️',
    description: 'Enterprise hypervisors and virtual desktop infrastructure.',
    technologies: [
      { name: 'Proxmox VE', description: 'Primary hypervisor for homelab and production workloads with clustering and HA' },
      { name: 'Microsoft Hyper-V', description: 'Windows Server virtualization for enterprise environments' },
      { name: 'Azure VDI', description: 'Azure Virtual Desktop deployments for remote workforce' },
      { name: 'Windows 365 Cloud PC', description: 'Cloud-based Windows desktops for hybrid work scenarios' },
      { name: 'LXC Containers', description: 'Lightweight Linux containers for efficient resource utilization' },
      { name: 'VMware ESXi', description: 'Enterprise virtualization platform experience' },
    ],
  },
  {
    title: 'Networking & Security',
    icon: '🛡️',
    description: 'Firewalls, VPNs, and network infrastructure management.',
    technologies: [
      { name: 'Fortinet FortiGate', description: 'Next-gen firewalls with UTM, SSL inspection, and SD-WAN' },
      { name: 'Tailscale', description: 'Zero-trust mesh VPN for secure remote access and site-to-site connectivity' },
      { name: 'UniFi Network', description: 'Ubiquiti SDN controllers, switches, and access points' },
      { name: 'SD-WAN', description: 'Software-defined WAN with automatic failover and traffic optimization' },
      { name: 'pfSense/OPNsense', description: 'Open-source firewall and routing platforms' },
      { name: 'WireGuard', description: 'Modern VPN protocol for high-performance tunnels' },
    ],
  },
  {
    title: 'Monitoring & Security',
    icon: '🔐',
    description: 'EDR, SIEM, and observability across endpoints and infrastructure.',
    technologies: [
      { name: 'Huntress EDR', description: 'Managed detection & response for endpoint threat hunting and remediation' },
      { name: 'Wazuh SIEM', description: 'Open-source SIEM/XDR for log analysis, file integrity, and compliance' },
      { name: 'CrowdSec', description: 'Distributed, crowd-sourced intrusion prevention across hosts and edge' },
      { name: 'Prometheus + Exporters', description: 'Metrics collection with node_exporter and Proxmox pve-exporter' },
      { name: 'Grafana', description: 'Dashboards and visualization for metrics, logs, and alerting' },
      { name: 'Defender for Business', description: 'Microsoft endpoint protection and threat analytics for M365 tenants' },
      { name: 'Defender for Cloud Apps', description: 'CASB for SaaS visibility, shadow IT discovery, and policy enforcement' },
    ],
  },
  {
    title: 'Secrets & Password Management',
    icon: '🔑',
    description: 'Vaulting, secure sharing, and SSO-backed credential management.',
    technologies: [
      { name: 'Bitwarden', description: 'Password vaults, secure sharing, and credential management for business and personal use' },
      { name: 'Vaultwarden', description: 'Self-hosted Bitwarden-compatible server for homelab credentials, testing, and lab service hosting' },
      { name: 'Entra ID SSO', description: 'SAML/OIDC single sign-on fronting the enterprise vault with conditional access' },
      { name: 'Passkeys', description: 'Passwordless, phishing-resistant sign-in using WebAuthn credentials' },
      { name: 'FIDO2 Security Keys', description: 'Hardware-backed authentication for phishing-resistant MFA and passwordless sign-in' },
    ],
  },
  {
    title: 'Crypto Hardware Wallets',
    icon: '🔐',
    description: 'Hardware wallets, on-device transaction review, and offline signing.',
    technologies: [
      { name: 'Keystone 3 Pro', description: 'Air-gapped wallet with QR-based transaction signing' },
      { name: 'Ledger Stax', description: 'Touchscreen hardware wallet with on-device transaction review and signing' },
      { name: 'Trezor', description: 'Hardware wallets and account management through Trezor Suite' },
      { name: 'Tangem', description: 'NFC hardware wallets used with the Tangem mobile app' },
      { name: 'NGRAVE', description: 'ZERO air-gapped hardware wallet with QR-based transaction signing' },
    ],
  },
  {
    title: 'Software Wallets',
    icon: '👛',
    description: 'Wallet applications for account management, transactions, and dApp connections.',
    technologies: [
      { name: 'Xaman', description: 'XRP Ledger wallet for account management and transaction signing' },
      { name: 'HashPack', description: 'Hedera wallet for HBAR, tokens, and dApp connections' },
      { name: 'xBull', description: 'Stellar wallet for account management and transaction signing' },
      { name: 'MetaMask', description: 'Wallet for Ethereum and EVM networks, tokens, and dApp connections' },
    ],
  },
  {
    title: 'Microsoft 365 & Azure',
    icon: '☁️',
    description: 'Cloud infrastructure, identity, and productivity at scale.',
    technologies: [
      { name: 'Microsoft 365 Admin', description: 'Tenant management, licensing, and user administration at scale' },
      { name: 'Microsoft Intune', description: 'MDM/MAM for device enrollment, policies, and app deployment' },
      { name: 'Azure AD / Entra ID', description: 'Identity management, conditional access, and SSO' },
      { name: 'Azure Infrastructure', description: 'VMs, networking, storage, and hybrid connectivity' },
      { name: 'Entra App Proxy', description: 'Secure remote access to on-prem web apps without a VPN' },
      { name: 'Azure Site Recovery', description: 'Cloud DR orchestration with failover and replication' },
      { name: 'Azure Backup / Recovery Vault', description: 'Centralized backup vaults for VMs, files, and workloads' },
      { name: 'Power Automate', description: 'Low-code workflow automation across M365 and external services' },
      { name: 'Power BI', description: 'Business intelligence dashboards and data reporting' },
      { name: 'Exchange Online', description: 'Email administration, mail flow rules, and migration' },
      { name: 'Teams Phone / VOIP', description: 'Cloud voice with call queues, auto attendants, and direct routing' },
      { name: 'SharePoint & OneDrive', description: 'Document management and collaboration platforms' },
    ],
  },
  {
    title: 'Email Security',
    icon: '📧',
    description: 'Advanced threat protection and email filtering solutions.',
    technologies: [
      { name: 'Proofpoint', description: 'Enterprise email security with threat intelligence' },
      { name: 'Avanan', description: 'API-based email security for M365 and Google Workspace' },
      { name: 'Microsoft Defender', description: 'Built-in M365 security with Safe Links and Safe Attachments' },
      { name: 'DMARC/DKIM/SPF', description: 'Email authentication and anti-spoofing configuration' },
    ],
  },
  {
    title: 'MSP Stack & Documentation',
    icon: '📋',
    description: 'Business management, ticketing, and documentation platforms.',
    technologies: [
      { name: 'Hudu', description: 'Self-hosted IT documentation platform (current internal use)' },
      { name: 'IT Glue', description: 'Cloud-based documentation and password management' },
      { name: 'ConnectWise/Autotask', description: 'PSA platforms for ticketing and billing' },
      { name: 'Kaseya BMS', description: 'PSA for ticketing, billing, and service delivery' },
      { name: 'Pax8', description: 'Microsoft 365 / cloud partner and reseller marketplace for licensing and provisioning' },
      { name: 'ScreenConnect', description: 'Self-hosted remote support behind Tailscale in Azure' },
      { name: 'NinjaRMM', description: 'Remote monitoring and management platform' },
      { name: 'Datto', description: 'BCDR appliances and cloud backup for business continuity' },
      { name: 'Veeam', description: 'Backup and disaster recovery for VMs, M365, and physical workloads' },
    ],
  },
  {
    title: 'Cloud Storage & Object',
    icon: '🗄️',
    description: 'Object storage and S3-compatible backends for backups and workloads.',
    technologies: [
      { name: 'Azure Blob Storage', description: 'Tiered object storage for backups, archives, and app data' },
      { name: 'Wasabi', description: 'Low-cost S3-compatible hot cloud storage with no egress fees' },
      { name: 'Backblaze B2', description: 'Affordable S3-compatible object storage for offsite backups' },
      { name: 'Amazon S3', description: 'Industry-standard object storage and the S3 API baseline' },
      { name: 'MinIO', description: 'Self-hosted S3-compatible object storage on own infrastructure' },
