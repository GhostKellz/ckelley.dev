---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navigation from '@components/Navigation.astro';
import PageHero from '@components/PageHero.astro';
import SectionHeading from '@components/SectionHeading.astro';
import { infrastructureHighlights as highlights } from '../data/infrastructure';
import '@styles/global.css';

interface Card {
  title: string;
  icon: string;
  body: string;
}

const virtualization: Card[] = [
  {
    title: 'Proxmox VE Cluster',
    icon: '🧮',
    body: 'Corosync quorum and HA across the cluster, with guest restart after host failure and firewall policies at the datacenter, node, and guest levels.',
  },
  {
    title: 'ZFS Storage',
    icon: '🗄️',
    body: 'NVMe mirrors and RAIDz2 pools, compression, scheduled scrubs, and snapshots support storage operations and recovery.',
  },
  {
    title: 'Software-Defined Networking',
    icon: '🕸️',
    body: 'VLAN-aware bridges and virtual network overlays separate workloads across the cluster, with host networking managed alongside the guests.',
  },
  {
    title: 'VFIO GPU Passthrough',
    icon: '🎮',
    body: 'Dedicated GPUs passed through to virtual machines, including the RTX 4090 used for inference and other compute workloads.',
  },
  {
    title: 'Cloud-Init & LXC',
    icon: '📜',
    body: 'VM templates, cloud-init configuration, and LXC containers make provisioning repeatable across the lab.',
  },
  {
    title: 'GitOps & IaC',
    icon: '⚙️',
    body: 'Terraform, Ansible, and version-controlled configuration support provisioning and changes to infrastructure and services.',
  },
];

const edgeSecurity: Card[] = [
  {
    title: 'SD-WAN: Failover & Load Balancing',
    icon: '🛰️',
    body: 'FortiGate manages fiber and cable connections with link health checks, failover, and traffic steering based on workload and connection quality.',
  },
  {
    title: 'UTM Inspection',
    icon: '🛡️',
    body: 'FortiGate inspection, filtering, and threat feeds provide layered controls at the edge, including a CrowdSec blocklist feed.',
  },
  {
    title: 'Tailscale Mesh VPN',
    icon: '🔗',
    body: 'Tailscale provides remote access to internal services. A separate Headscale development setup supports control-plane experimentation.',
  },
  {
    title: 'HA & Automation Stitches',
    icon: '🤖',
    body: 'Edge high availability and automation stitches support failover, event-driven responses, scheduled configuration backups, and notifications.',
  },
];

// Why the observability/security stack is built the way it is
const designChoices: Card[] = [
  {
    title: 'Prometheus + Exporters',
    icon: '📈',
    body: 'Host and Proxmox exporters feed metrics into Prometheus. Version-controlled targets make monitoring part of infrastructure configuration.',
  },
  {
    title: 'Wazuh SIEM/XDR',
    icon: '🛰️',
    body: 'Host agents collect security telemetry and file-integrity events for centralized investigation and correlation.',
  },
  {
    title: 'CrowdSec (Distributed)',
    icon: '🧱',
    body: 'Log-based detections feed blocking decisions to configured bouncers, with a mirrored blocklist available to the FortiGate edge.',
  },
  {
    title: 'Centralized Logging',
    icon: '🪵',
    body: 'syslog-ng collects infrastructure and firewall logs for Loki. Labels organize the streams, and LogQL supports investigation.',
  },
  {
    title: 'Tailscale-Only Access',
    icon: '🔒',
    body: 'Monitoring dashboards are reached over the tailnet, with a TLS reverse proxy providing access to the internal services.',
  },
  {
    title: 'Grafana Dashboards',
    icon: '📊',
    body: 'Dashboards bring together metrics, logs, and security data, with Alertmanager handling notification routing.',
  },
];

const backup: Card[] = [
  {
    title: 'BTRFS + Snapper',
    icon: '🧬',
    body: 'Workstation snapshots provide a recovery point around system changes and package updates.',
  },
  {
    title: 'Restic',
    icon: '📦',
    body: 'Encrypted, deduplicated backups protect configuration and application data on hosts outside the hypervisor backup workflow.',
  },
  {
    title: 'ZFS + Proxmox Backup Server',
    icon: '🧷',
    body: 'ZFS snapshots and replication support local recovery, while Proxmox Backup Server maintains guest backups.',
  },
  {
    title: 'Veeam Backup & Replication',
    icon: '♻️',
    body: 'Backup and restore tooling for virtual machines and physical workloads, alongside Microsoft 365 backup workflows.',
  },
  {
    title: 'Synology NAS (DSM)',
    icon: '🗃️',
    body: 'Active Backup protects Microsoft 365 and Google Workspace data, with Hyper Backup providing an encrypted offsite copy to Wasabi.',
  },
  {
    title: 'Wasabi S3 (Offsite)',
    icon: '☁️',
    body: 'S3-compatible storage holds encrypted offsite backup copies, adding a recovery layer outside the local cluster.',
  },
];

const sections = [
  { id: 'topology', label: 'Topology' }, { id: 'systems', label: 'Linux & compute' },
  { id: 'networking', label: 'Networking' }, { id: 'observability', label: 'Observability' },
  { id: 'recovery', label: 'Recovery' },
];
---

<BaseLayout title="Lab | Christopher Kelley" description="The infrastructure I build and operate: a Proxmox cluster, Linux systems, FortiGate networking, observability, and layered backup and recovery.">
  <Navigation />
  <main class="pt-24 portfolio-page">
    <PageHero eyebrow="The Lab" title="Infrastructure I build." accent="Systems I operate."
      description="A working environment for services, software development, and infrastructure experiments. Linux hosts, a Proxmox cluster, network security, and recovery tooling all connect here."
      links={sections}>
      <div class="flex flex-wrap gap-3 mt-8"><a href="/architecture" class="btn btn-primary">Explore the Architecture →</a><a href="/ai" class="btn btn-secondary">AI Workloads →</a></div>
      <dl class="grid grid-cols-3 gap-4 mt-10 max-w-2xl">
        {highlights.map(stat => <div><dt class="text-slate text-sm mb-2">{stat.label}</dt><dd class="text-2xl md:text-3xl font-bold text-accent">{stat.value}</dd></div>)}
      </dl>
    </PageHero>

    <section id="topology" class="section bg-navy-light/30">
      <div class="container-narrow">
        <SectionHeading eyebrow="01 / Topology" title="See how the" accent="pieces connect." description="An overview of the physical and virtual environment. Expand the diagram for a closer look, or visit Architecture for the detailed walkthrough." />
        <button id="expand-topology" type="button" class="card p-2 md:p-4 w-full cursor-zoom-in" aria-haspopup="dialog" aria-controls="topology-dialog" aria-label="Expand infrastructure diagram">
          <img src="/infrastructure.png" alt="Overview of the lab network, compute hosts, and connected services" class="w-full h-auto rounded-lg" loading="lazy" />
          <span class="block text-accent text-sm font-mono mt-3">Expand diagram ↗</span>
        </button>
        <dialog id="topology-dialog" aria-labelledby="topology-dialog-title">
          <div class="flex justify-between items-center gap-4 mb-4"><h2 id="topology-dialog-title" class="text-lg font-semibold">Infrastructure overview</h2><form method="dialog"><button class="btn btn-primary" autofocus>Close</button></form></div>
          <img src="/infrastructure.png" alt="Expanded lab network and infrastructure overview" />
        </dialog>
      </div>
    </section>

    <section id="systems" class="section">
      <div class="container-narrow">
        <SectionHeading eyebrow="02 / Linux & Compute" title="Understand the host." accent="Build repeatable systems." description="Arch Linux is my daily development environment, with Debian and Ubuntu supporting server workloads. Proxmox brings together virtual machines, containers, storage, and GPU passthrough." />
        <p class="portfolio-copy max-w-3xl mb-8">Day-to-day operations span systemd services, journald diagnostics, host firewalling, and storage management. Templates and configuration tooling help reproduce setups, while runbooks and repository documentation capture the decisions needed to maintain them.</p>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
          {virtualization.map(card => <article class="card"><h3>{card.title}</h3><p class="portfolio-copy mt-3">{card.body}</p></article>)}
        </div>
        <a href="/ai" class="link inline-block mt-6">See the 5090, 4090, and Spark cluster in the AI stack →</a>
      </div>
    </section>

    <section id="networking" class="section bg-navy-light/30">
      <div class="container-narrow">
        <SectionHeading eyebrow="03 / Networking & Edge" title="Connect the workloads." accent="Control the boundaries." description="FortiGate handles edge policy and WAN connectivity, UniFi supports switching and wireless, and Tailscale provides remote access to internal services." />
        <div class="grid md:grid-cols-2 gap-4">
          {edgeSecurity.map(card => <article class="card"><h3>{card.title}</h3><p class="portfolio-copy mt-3">{card.body}</p></article>)}
        </div>
      </div>
    </section>

    <section id="observability" class="section">
      <div class="container-narrow">
        <SectionHeading eyebrow="04 / Observability & Detection" title="Follow the signals." accent="Find the cause." description="Metrics, logs, and security events support a shared view of the environment, from host health to edge detections." />
        <!-- Diagram -->
        <div class="card p-6 md:p-10">
          <!-- Sources row -->
          <p class="text-center text-slate text-xs font-mono uppercase tracking-wider mb-4">Sources</p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-2">
            <div class="rounded-lg border border-accent/30 bg-navy/50 p-4 text-center">
              <p class="text-slate-light font-semibold text-sm">Proxmox Cluster</p>
              <p class="text-slate text-xs mt-1">node_exporter + pve-exporter</p>
            </div>
            <div class="rounded-lg border border-accent/30 bg-navy/50 p-4 text-center">
              <p class="text-slate-light font-semibold text-sm">Hosts & Services</p>
              <p class="text-slate text-xs mt-1">Wazuh agents · syslog-ng</p>
            </div>
            <div class="rounded-lg border border-accent/30 bg-navy/50 p-4 text-center">
              <p class="text-slate-light font-semibold text-sm">Edge & Firewalls</p>
              <p class="text-slate text-xs mt-1">FortiGate · CrowdSec parsers</p>
            </div>
          </div>

          <!-- Arrow down -->
          <div class="flex justify-center my-3">
            <span class="text-accent text-2xl">↓</span>
          </div>

          <!-- Collection / processing row -->
          <p class="text-center text-slate text-xs font-mono uppercase tracking-wider mb-4">Collection & Detection</p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="rounded-lg border border-aqua/40 bg-navy/50 p-4 text-center">
              <p class="text-aqua-light font-semibold text-sm">Prometheus + Loki</p>
              <p class="text-slate text-xs mt-1">Metrics TSDB · log store</p>
            </div>
            <div class="rounded-lg border border-aqua/40 bg-navy/50 p-4 text-center">
              <p class="text-aqua-light font-semibold text-sm">Wazuh Manager</p>
              <p class="text-slate text-xs mt-1">SIEM/XDR correlation</p>
            </div>
            <div class="rounded-lg border border-aqua/40 bg-navy/50 p-4 text-center">
              <p class="text-aqua-light font-semibold text-sm">CrowdSec LAPI</p>
              <p class="text-slate text-xs mt-1">Decisions → bouncers</p>
            </div>
          </div>

          <!-- Arrow down -->
          <div class="flex justify-center my-3">
            <span class="text-accent text-2xl">↓</span>
          </div>

          <!-- Presentation row -->
          <p class="text-center text-slate text-xs font-mono uppercase tracking-wider mb-4">Visualization</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-2xl mx-auto">
            <div class="rounded-lg border border-accent/40 bg-navy/50 p-4 text-center">
              <p class="text-accent font-semibold text-sm">Grafana</p>
              <p class="text-slate text-xs mt-1">Dashboards · alerts</p>
            </div>
            <div class="rounded-lg border border-accent/40 bg-navy/50 p-4 text-center">
              <p class="text-accent font-semibold text-sm">Wazuh Dashboard</p>
              <p class="text-slate text-xs mt-1">Security analytics</p>
            </div>
          </div>

          <!-- Access note -->
          <div class="mt-8 flex justify-center">
            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-slate-dark/40 bg-navy/60 text-slate text-xs font-mono">
              🔒 Reverse proxy (TLS) bound to Tailscale only, no public exposure
            </span>
          </div>
        </div>


        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 mt-8">
          {designChoices.map(card => <article class="card"><h3>{card.title}</h3><p class="portfolio-copy mt-3">{card.body}</p></article>)}
        </div>
      </div>
    </section>

    <section id="recovery" class="section bg-navy-light/30">
      <div class="container-narrow">
        <SectionHeading eyebrow="05 / Backup & Recovery" title="Plan for failure." accent="Keep a way back." description="Recovery is layered across local snapshots, separate backups, and offsite copies. Each layer covers a different kind of failure." />
        <ol class="grid md:grid-cols-3 gap-4 mb-8" aria-label="Recovery layers">
          <li class="rounded-lg border border-accent/30 p-5"><p class="section-eyebrow">Layer 01 / Local</p><h3 class="font-semibold text-lg">Snapshots & rollback</h3><p class="portfolio-copy mt-2">Recover from an unwanted system or configuration change.</p></li>
          <li class="rounded-lg border border-accent/30 p-5"><p class="section-eyebrow">Layer 02 / Backup</p><h3 class="font-semibold text-lg">Separate restore points</h3><p class="portfolio-copy mt-2">Restore workloads and data using the appropriate backup tool.</p></li>
          <li class="rounded-lg border border-accent/30 p-5"><p class="section-eyebrow">Layer 03 / Offsite</p><h3 class="font-semibold text-lg">Copies beyond the site</h3><p class="portfolio-copy mt-2">Retain a recovery option when local infrastructure is unavailable.</p></li>
        </ol>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
          {backup.map(card => <article class="card"><h3>{card.title}</h3><p class="portfolio-copy mt-3">{card.body}</p></article>)}
        </div>
      </div>
    </section>
    <section class="section text-center"><div class="container-narrow"><h2 class="section-title">Build it with <span>operations in mind.</span></h2><p class="section-description mb-6">Infrastructure design, monitoring, and recovery are parts of the same job.</p><div class="flex flex-wrap justify-center gap-4"><a href="/#contact" class="btn btn-primary">Get In Touch</a><a href="/technologies" class="btn btn-secondary">View Technologies</a></div></div></section>
  </main>
  <footer class="py-8 text-center"><a href="/" class="link text-sm font-mono">← Back to Home</a></footer>
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#topology-dialog');
  const opener = document.querySelector<HTMLButtonElement>('#expand-topology');
  opener?.addEventListener('click', () => { dialog?.showModal(); document.documentElement.style.overflow = 'hidden'; });
  dialog?.addEventListener('close', () => { document.documentElement.style.overflow = ''; opener?.focus(); });
  dialog?.addEventListener('click', event => {
    const bounds = dialog.getBoundingClientRect();
    if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
  });
</script>
<style>
  dialog { margin: auto; width: min(96vw, 90rem); max-height: 94dvh; overflow: auto; padding: 1.25rem; background: var(--color-navy); color: var(--color-slate-light); border: 1px solid var(--color-slate-dark); border-radius: 0.75rem; }
  dialog::backdrop { background: rgb(2 12 27 / 92%); backdrop-filter: blur(4px); }
  dialog img { display: block; max-width: 100%; height: auto; margin: auto; }
</style>
