const allProjects = categories.flatMap(category => category.projects);
const languages = [...new Set(allProjects.map(project => project.language))].sort();
const categoryId = (title: string) => title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/-$/, '');
const featured = [
  { name: 'ctl365', focus: 'Microsoft 365 operations', detail: 'Tenant provisioning and endpoint rollout involve repeated administrative steps. ctl365 brings that work into a Rust CLI focused on deployment automation.' },
  { name: 'ghostctl', focus: 'Linux administration', detail: 'A modular CLI brings common system tasks into one toolkit, spanning storage, backups, services, and virtualization. The project connects my Linux operations work with software development.' },
  { name: 'jarvis', focus: 'Local AI tooling', detail: 'A CLI companion combining persistent memory, model routing, and tools. SQLite full-text search and an MCP server connect the agent experience to the surrounding development environment.' },
].map(item => ({ ...allProjects.find(project => project.name === item.name)!, ...item }));
---

<BaseLayout title="Projects | Christopher Kelley" description="Software projects spanning infrastructure automation, local AI, Zig libraries, and Linux tools by Christopher Kelley.">
  <Navigation />
  <main class="pt-24 portfolio-page">
    <PageHero eyebrow="Projects" title="Tools I build." accent="Problems I solve."
      description="Software shaped by the systems I operate, from Microsoft 365 and Linux administration to local AI, developer infrastructure, and systems programming."
      links={[{ id: 'featured', label: 'Featured work' }, ...categories.map(category => ({ id: categoryId(category.title), label: category.title }))]}>
      <div class="flex flex-wrap gap-3 mt-8">
        <a href="https://github.com/GhostKellz" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Personal GitHub ↗</a>
        <a href="https://github.com/CK-Technology" class="btn btn-secondary" target="_blank" rel="noopener noreferrer">CK Technology ↗</a>
      </div>
    </PageHero>

    <section id="featured" class="section bg-navy-light/30">
      <div class="container-narrow">
        <SectionHeading eyebrow="Selected work" title="A closer look at" accent="what I build." description="Three projects connecting day-to-day operations, software engineering, and AI tooling." />
        <div class="grid lg:grid-cols-3 gap-4">
          {featured.map(project => (
            <article class="card flex flex-col border-t-2 border-t-accent-muted">
              <p class="section-eyebrow">{project.focus}</p>
              <h3>{project.name}</h3>
              <p class="portfolio-copy mt-3 grow">{project.detail}</p>
              <a class="link mt-6 inline-block" href={project.url} target="_blank" rel="noopener noreferrer">Explore {project.name} ↗</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <div class="container-narrow px-6 pt-12 flex flex-wrap items-center gap-4">
      <label for="project-language" class="font-semibold">Browse by language</label>
      <select id="project-language" class="bg-navy-light border border-slate-dark rounded-md px-4 py-3 text-slate-light">
        <option value="all">All languages & formats</option>
        {languages.map(language => <option value={language}>{language}</option>)}
      </select>
      <p id="project-count" class="text-slate text-sm" role="status">{allProjects.length} projects</p>
    </div>

    {categories.map((category, index) => (
      <section id={categoryId(category.title)} data-project-category class={`section ${index % 2 ? 'bg-navy-light/30' : ''}`}>
        <div class="container-narrow">
          <SectionHeading eyebrow={`Collection ${String(index + 1).padStart(2, '0')}`} title={category.title.split(' & ')[0]} accent={category.title.includes(' & ') ? `& ${category.title.split(' & ')[1]}` : undefined} description={category.description} />
          <div class="grid md:grid-cols-2 gap-4">
            {category.projects.map(project => (
              <a href={project.url} target="_blank" rel="noopener noreferrer" data-project-language={project.language} class="card group block">
                <div class="flex items-start justify-between gap-4">
                  <h3 class="group-hover:text-accent transition-colors">{project.name}</h3>
                  <span class="text-accent" aria-hidden="true">↗</span>
                </div>
                <p class="portfolio-copy mt-3 mb-4">{project.description.trim()}</p>
                <span class="text-sm text-slate-light inline-flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full" style={`background-color: ${project.languageColor}`} aria-hidden="true"></span>{project.language}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))}
    <section class="section text-center bg-navy-light/30">
      <div class="container-narrow">
        <h2 class="section-title">Have something <span>to build?</span></h2>
        <p class="section-description mb-6">Get in touch about a project, an integration, or an infrastructure problem.</p>
        <a href="/#contact" class="btn btn-primary">Get In Touch</a>
      </div>
    </section>
  </main>
  <footer class="py-8 text-center"><a href="/" class="link text-sm font-mono">← Back to Home</a></footer>
</BaseLayout>

<script>
  const filter = document.querySelector<HTMLSelectElement>('#project-language');
  const updateProjects = () => {
    let count = 0;
    document.querySelectorAll<HTMLElement>('[data-project-language]').forEach(card => {
      card.hidden = filter?.value !== 'all' && card.dataset.projectLanguage !== filter?.value;
      if (!card.hidden) count++;
    });
    document.querySelectorAll<HTMLElement>('[data-project-category]').forEach(section => {
      section.hidden = !section.querySelector('[data-project-language]:not([hidden])');
    });
    const status = document.querySelector('#project-count');
    if (status) status.textContent = `${count} ${count === 1 ? 'project' : 'projects'}`;
  };
  filter?.addEventListener('change', updateProjects);
  // A category jump should always reveal its destination, even after filtering.
  document.querySelectorAll<HTMLAnchorElement>('.page-jumps a').forEach(link => {
    link.addEventListener('click', () => { if (filter) { filter.value = 'all'; updateProjects(); } });
  });
</script>
