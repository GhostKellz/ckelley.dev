---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navigation from '@components/Navigation.astro';
import '@styles/global.css';

interface Project {
  name: string;
  description: string;
  url: string;
  stars?: number;
  language: string;
  languageColor: string;
}

interface Category {
  title: string;
  description: string;
  projects: Project[];
}

const categories: Category[] = [
  {
    title: 'Infrastructure & MSP Tools',
    description: 'Enterprise-grade tools for managed service providers and IT operations.',
    projects: [
      {
        name: 'ctl365',
        description: 'Microsoft 365 deployment automation for MSPs and IT pros. Streamlines tenant provisioning, configuration, and endpoint rollout at scale.',
        url: 'https://github.com/resotech/ctl365',
        language: 'Rust',
        languageColor: '#dea584',
      },
      {
        name: 'strix',
        description: 'High-performance S3-compatible object storage server. Features IAM policies, bucket versioning, SSE encryption, Object Lock, and multi-tenancy.',
        url: 'https://github.com/CK-Technology/strix',
        language: 'Rust',
        languageColor: '#dea584',
      },
      {
        name: 'bolt',
        description: 'Next-generation container runtime & orchestration. Fast, secure, and declarative.',
        url: 'https://github.com/CK-Technology/bolt',
        language: 'Rust',
        languageColor: '#dea584',
      },
      {
        name: 'public-misc',
        description: 'Collection of IT administration one-liners and utility scripts for day-to-day MSP operations and endpoint management.',
        url: 'https://github.com/CK-Technology/public-misc',
        language: 'PowerShell',
        languageColor: '#012456',
      },
      {
        name: 'nexus',
        description: 'Modern ticketing system for tech teams and MSPs.',
        url: 'https://github.com/CK-Technology/nexus',
        stars: 1,
        language: 'Svelte',
        languageColor: '#ff3e00',
      },
      {
        name: 'ghostwarden',
        description: 'High-performance Proxmox VE security bouncer with CrowdSec and Wazuh integration.',
        url: 'https://github.com/CK-Technology/ghostwarden',
        language: 'Rust',
        languageColor: '#dea584',
      },
      {
        name: 'noveliron.com',
        description: 'Sample client marketing site, a fast static Astro front-end demonstrating clean design and deployment.',
        url: 'https://github.com/CK-Technology/noveliron.com',
        language: 'Astro',
        languageColor: '#ff5a03',
      },
    ],
  },
  {
    title: 'Zig Ecosystem',
    description: 'Building the future of systems programming with Zig libraries and tools.',
    projects: [
      {
        name: 'zquic',
        description: 'Lightweight, high-performance QUIC (HTTP/3 transport layer) implementation written in pure Zig.',
        url: 'https://github.com/GhostKellz/zquic',
        stars: 33,
        language: 'Zig',
        languageColor: '#ec915c',
      },
      {
        name: 'zqlite',
        description: 'Blazing-fast, standalone, embedded SQL-compatible database built from scratch in Zig.',
        url: 'https://github.com/GhostKellz/zqlite',
        stars: 12,
        language: 'Zig',
        languageColor: '#ec915c',
      },
      {
        name: 'zsync',
        description: 'Blazing fast, lightweight, and modular async runtime for Zig.',
        url: 'https://github.com/GhostKellz/zsync',
        stars: 6,
        language: 'Zig',
        languageColor: '#ec915c',
      },
      {
        name: 'zion',
        description: 'Modern, comprehensive development tool for Zig projects.',
        url: 'https://github.com/GhostKellz/zion',
        stars: 4,
        language: 'Zig',
        languageColor: '#ec915c',
      },
      {
        name: 'flash',
        description: 'Lightning-fast, async-native CLI framework for Zig.',
        url: 'https://github.com/GhostKellz/flash',
        stars: 1,
        language: 'Zig',
        languageColor: '#ec915c',
      },
      {
        name: 'ghostlang',
        description: 'Lightweight embedded scripting engine written in Zig.',
        url: 'https://github.com/ghostkellz/ghostlang',
        language: 'Zig',
        languageColor: '#ec915c',
      },
    ],
  },
  {
    title: 'Ecosystem Projects',
    description: 'Package registries, dependency management, and developer infrastructure.',
    projects: [
      {
        name: 'GhostCP',
        description: 'Rust-powered hosting control panel. HestiaCP reimagined with Leptos and NGINX.',
        url: 'https://github.com/CK-Technology/GhostCP',
        stars: 3,
        language: 'Rust',
        languageColor: '#dea584',
      },
      {
        name: 'ghostcrate',
        description: 'Self-hosted Rust crate registry & package server. Run your own private crates.io.',
        url: 'https://github.com/GhostKellz/ghostcrate',
        language: 'Rust',
        languageColor: '#dea584',
      },
      {
        name: 'zepplin',
        description: 'Minimal, high-performance companion for managing Zig projects and packages.',
        url: 'https://github.com/GhostKellz/zepplin',
        language: 'Zig',
        languageColor: '#ec915c',
      },
      {
        name: 'ghostport',
        description: 'All-in-one Docker registry with high-performance OCI-compliant registry and modern web interface built-in.',
        url: 'https://github.com/CK-Technology/ghostport',
        language: 'Rust',
        languageColor: '#dea584',
      },
    ],
  },
  {
    title: 'Rust CLI & Desktop Tools',
    description: 'Modern command-line tools and applications for Linux power users.',
    projects: [
      {
        name: 'jarvis',
        description: 'CLI-native, local-first AI companion built in Rust. Persistent memory with SQLite FTS5, agent autonomy, an MCP server, and multi-provider routing with voice I/O.',
        url: 'https://github.com/ghostkellz/jarvis',
        language: 'Rust',
        languageColor: '#dea584',
      },
      {
        name: 'llama-rs',
        description: 'Pure-Rust GGUF Llama inference engine, verified byte-identical to llama.cpp. CUDA acceleration via Candle with an OpenAI-compatible server.',
        url: 'https://github.com/ghostkellz/llama-rs',
        language: 'Rust',
        languageColor: '#dea584',
      },
      {
        name: 'zeke',
        description: 'Local-first AI routing and caching layer in Rust. Multi-provider abstraction, dual-tier caching, and usage tracking behind one embeddable client.',
        url: 'https://github.com/ghostkellz/zeke',
        language: 'Rust',
        languageColor: '#dea584',
      },
      {
        name: 'rift',
        description: 'Dynamic tiling window manager for KDE Plasma 6 on Wayland. A Rust daemon paired with a thin KWin agent, built as an architectural exploration.',
        url: 'https://github.com/ghostkellz/rift',
        language: 'Rust',
        languageColor: '#dea584',
      },
      {
        name: 'ghostctl',
        description: 'Modern, modular CLI toolkit for Linux sysadmins and homelabbers. Supports Btrfs, Restic, systemd, Neovim, Proxmox, and more.',
        url: 'https://github.com/GhostKellz/ghostctl',
        stars: 3,
        language: 'Rust',
        languageColor: '#dea584',
      },
      {
        name: 'ghostwave',
        description: 'NVIDIA RTX Voice-powered noise suppression for Linux.',
        url: 'https://github.com/GhostKellz/ghostwave',
        stars: 2,
        language: 'Rust',
        languageColor: '#dea584',
      },
      {
        name: 'nova',
        description: 'Wayland-native Virtualization & Container Manager. Bare metal speed, declarative control, GPU-first.',
        url: 'https://github.com/GhostKellz/nova',
        stars: 1,
        language: 'Rust',
        languageColor: '#dea584',
      },
      {
        name: 'ghostfetch',
        description: 'Fast, minimal system information tool for Linux.',
        url: 'https://github.com/GhostKellz/ghostfetch',
        language: 'Rust',
        languageColor: '#dea584',
      },
      {
        name: 'archon',
        description: 'Archon, the Sovereign Browser.',
        url: 'https://github.com/GhostKellz/archon',
        stars: 1,
        language: 'Rust',
        languageColor: '#dea584',
      },
      {
        name: 'nvcontrol',
        description: 'Modern, fully featured NVIDIA settings manager for Linux. NVIDIA Control Panel & GeForce Experience for Linux + Wayland.',
        url: 'https://github.com/GhostKellz/nvcontrol',
        stars: 1,
        language: 'Rust',
        languageColor: '#dea584',
      },
    ],
  },
  {
    title: 'Arch Linux & DevOps',
    description: 'Configuration management, automation, and Linux tooling.',
    projects: [
      {
        name: 'arch',
        description: 'Personal, modular, and actively maintained Arch Linux configuration. Tuned for performance, security, and daily driver use.',
        url: 'https://github.com/GhostKellz/arch',
        stars: 1,
        language: 'Shell',
        languageColor: '#89e051',
      },
      {
        name: 'ghostbrew',
        description: 'GhostBrew (scx_ghostbrew) is a custom sched-ext BPF scheduler built specifically for AMD Zen5 and X3D processors.',
        url: 'https://github.com/GhostKellz/ghostbrew',
        stars: 1,
        language: 'Rust',
        languageColor: '#dea584',
      },
      {
        name: 'docker',
        description: 'Docker and Docker Compose library for common deployments.',
        url: 'https://github.com/GhostKellz/docker',
        stars: 1,
        language: 'Dockerfile',
        languageColor: '#384d54',
      },
      {
        name: 'fortigate',
        description: 'Fortigate Firewall repo for automation stitches, CLI reference, and configuration.',
        url: 'https://github.com/GhostKellz/fortigate',
        language: 'PowerShell',
        languageColor: '#012456',
      },
      {
        name: 'proxmox',
        description: 'Proxmox helper scripts and automation for cluster operations and node management.',
        url: 'https://github.com/ghostkellz/proxmox',
        stars: 2,
        language: 'Shell',
        languageColor: '#89e051',
      },
      {
        name: 'ghostkellz.sh',
        description: 'My personal landing site, hosting my GPG public key, contact details, and links across the ecosystem.',
        url: 'https://github.com/ghostkellz/ghostkellz.sh',
        language: 'Astro',
        languageColor: '#ff5a03',
      },
    ],
  },
];

const totalProjects = categories.reduce((acc, cat) => acc + cat.projects.length, 0);
const totalStars = categories.reduce((acc, cat) =>
  acc + cat.projects.reduce((a, p) => a + (p.stars || 0), 0), 0);
---

<BaseLayout title="Projects | Christopher Kelley" description="Open source projects and tools by Christopher Kelley - Zig libraries, Rust CLI tools, and MSP infrastructure.">
  <Navigation />

  <main class="pt-24">
    <!-- Hero -->
    <section class="section pb-12">
      <div class="container-narrow text-center">
        <p class="heading-accent">Open Source</p>
        <h1 class="text-4xl md:text-5xl font-bold text-slate-light mb-4">Projects</h1>
        <p class="text-slate max-w-2xl mx-auto mb-8">
          Building tools for systems programmers, Linux enthusiasts, and MSPs.
          From low-level Zig libraries to full-stack Rust applications.
        </p>

        <!-- Stats -->
        <div class="flex justify-center gap-8 mb-8">
          <div class="text-center">
            <p class="text-3xl font-bold text-accent">{totalProjects}+</p>
            <p class="text-slate text-sm">Projects</p>
          </div>
          <div class="text-center">
            <p class="text-3xl font-bold text-accent">{totalStars}+</p>
            <p class="text-slate text-sm">Stars</p>
          </div>
          <div class="text-center">
            <p class="text-3xl font-bold text-accent">3</p>
            <p class="text-slate text-sm">Languages</p>
          </div>
        </div>

        <!-- GitHub Links -->
        <div class="flex justify-center gap-4">
          <a href="https://github.com/GhostKellz" target="_blank" rel="noopener" class="btn btn-primary">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
            @GhostKellz
          </a>
          <a href="https://github.com/CK-Technology" target="_blank" rel="noopener" class="btn btn-secondary">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
            CK-Technology
          </a>
        </div>
      </div>
    </section>

    <!-- Project Categories -->
    {categories.map((category, catIndex) => (
      <section class={`section py-16 ${catIndex % 2 === 1 ? 'bg-navy-light/30' : ''}`}>
        <div class="container-narrow">
          <div class="mb-10">
            <h2 class="text-2xl md:text-3xl font-bold text-slate-light mb-2">
              <span class="text-accent">⟨</span> {category.title} <span class="text-accent">⟩</span>
            </h2>
            <p class="text-slate">{category.description}</p>
          </div>

          <div class="grid md:grid-cols-2 gap-4">
            {category.projects.map(project => (
              <a
                href={project.url}
                target="_blank"
                rel="noopener"
                class="card group block hover:border-accent/50"
              >
                <div class="flex items-start justify-between mb-2">
                  <div class="flex items-center gap-2">
                    <svg class="w-5 h-5 text-slate group-hover:text-accent transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                    </svg>
                    <h3 class="font-semibold text-slate-light group-hover:text-accent transition-colors">
                      {project.name}
                    </h3>
                  </div>
                  {project.stars && project.stars > 0 && (
                    <span class="flex items-center gap-1 text-sm text-slate">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                      </svg>
                      {project.stars}
                    </span>
                  )}
                </div>

                <p class="text-slate text-sm mb-3 line-clamp-2">
                  {project.description}
                </p>

                <div class="flex items-center gap-2">
                  <span
                    class="w-3 h-3 rounded-full"
                    style={`background-color: ${project.languageColor}`}
                  ></span>
                  <span class="text-xs text-slate">{project.language}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))}

    <!-- CTA -->
    <section class="section text-center">
      <div class="container-narrow">
        <p class="text-slate mb-6">
          Want to collaborate or have questions about a project?
        </p>
        <a href="/#contact" class="btn btn-primary">
          Get In Touch
        </a>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="py-8 text-center">
    <p class="text-slate text-sm font-mono">
      <a href="/" class="text-accent hover:underline">← Back to Home</a>
    </p>
  </footer>
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
