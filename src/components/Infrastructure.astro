---
import { infrastructureHighlights as highlights } from '../data/infrastructure';
---

<section id="infrastructure" class="section overflow-hidden">
  <div class="container-narrow">
    <div class="reveal text-center mb-12">
      <p class="heading-accent">03. Infrastructure</p>
      <h2 class="heading">Built in the lab. <span>Operated every day.</span></h2>
      <p class="text-slate max-w-2xl mx-auto">
        I run a production-grade homelab that doubles as a learning platform and a real-world
        testing ground for enterprise solutions, from a Proxmox cluster to a full
        observability and security stack.
      </p>
    </div>

    <!-- Stats Grid with subtle parallax -->
    <div
      class="reveal grid grid-cols-3 gap-4 mb-12 parallax-element"
      data-parallax-speed="0.05"
      style="transition-delay: 0.1s;"
    >
      {highlights.map(stat => (
        <div class="card text-center py-6">
          <span class="text-2xl mb-2 block">{stat.icon}</span>
          <p class="text-3xl font-bold text-accent mb-1">{stat.value}</p>
          <p class="text-slate text-sm">{stat.label}</p>
        </div>
      ))}
    </div>

    <!-- CTA into the Lab deep-dive -->
    <div class="reveal flex flex-wrap justify-center gap-3" style="transition-delay: 0.2s;">
      <a href="/lab" class="btn btn-primary">
        Explore the Lab →
      </a>
      <a href="/ai" class="btn btn-secondary">Explore the AI Stack →</a>
    </div>
  </div>
</section>

<!-- Parallax Script -->
<script>
  // Parallax scroll effect
  const initParallax = () => {
    const parallaxElements = document.querySelectorAll('.parallax-element');
    const section = document.getElementById('infrastructure');

    if (!section || parallaxElements.length === 0) return;

    // Check if on mobile - disable parallax for performance
    const isMobile = window.matchMedia('(max-width: 768px)').matches;
    if (isMobile) return;

    let ticking = false;

    const updateParallax = () => {
      const sectionRect = section.getBoundingClientRect();
      const viewportHeight = window.innerHeight;

      // Only apply parallax when section is in view
      if (sectionRect.bottom < 0 || sectionRect.top > viewportHeight) {
        ticking = false;
        return;
      }

      // Calculate how far through the section we've scrolled
      const scrollProgress = (viewportHeight - sectionRect.top) / (viewportHeight + sectionRect.height);

      parallaxElements.forEach((el) => {
        const speed = parseFloat((el as HTMLElement).dataset.parallaxSpeed || '0.1');
        const yOffset = (scrollProgress - 0.5) * speed * 200;

        (el as HTMLElement).style.transform = `translateY(${yOffset}px)`;
      });

      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(updateParallax);
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });

    // Initial call
    updateParallax();
  };

  // Initialize on DOM ready
  document.addEventListener('DOMContentLoaded', initParallax);

  // Re-initialize on resize (in case switching to/from mobile)
  let resizeTimeout: number;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(initParallax, 250);
  });
</script>
