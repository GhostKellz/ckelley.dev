---

<section id="contact" class="section">
  <div class="container-narrow">
    <div class="reveal text-center mb-12">
      <p class="heading-accent">05. Contact</p>
      <h2 class="heading">Let’s <span>build something.</span></h2>
      <p class="text-slate max-w-xl mx-auto">
        I'm always open to discussing new opportunities, interesting projects, or just chatting about tech.
        Send me an email or reach out directly on Signal.
      </p>
    </div>

    <div class="reveal grid sm:grid-cols-2 gap-4 max-w-3xl mx-auto mb-10">
      <a href="mailto:ckelley@ghostkellz.sh" class="card contact-option group">
        <svg class="w-8 h-8 text-accent mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3 7 9 6 9-6" />
        </svg>
        <h3 class="text-lg font-semibold text-slate-light group-hover:text-accent">Email Me <span aria-hidden="true">→</span></h3>
        <p class="text-slate text-sm mt-2 break-all">ckelley@ghostkellz.sh</p>
      </a>
      <a href={signalUrl} target="_blank" rel="noopener noreferrer" class="card contact-option group border-accent/40">
        <svg class="w-8 h-8 text-accent mb-4" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="16" cy="15" r="13" stroke-dasharray="3 3" />
          <path d="M16 5a10 10 0 0 0-8.8 14.8L5 27l7.2-2.2A10 10 0 1 0 16 5Z" fill="var(--color-navy-light)" />
        </svg>
        <h3 class="text-lg font-semibold text-slate-light group-hover:text-accent">Message on Signal <span aria-hidden="true">↗</span></h3>
        <p class="text-slate text-sm font-mono mt-2">ghostkellz.18</p>
      </a>
    </div>

    <!-- Social Cards -->
    <div class="reveal grid md:grid-cols-2 gap-6 max-w-3xl mx-auto mb-16" style="transition-delay: 0.1s;">
      {socialLinks.map(link => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener"
          class={`card group flex flex-col items-center text-center py-8 ${link.color}`}
        >
          <div class="text-slate group-hover:text-accent transition-colors mb-4" set:html={link.icon} />
          <h3 class="text-slate-light font-semibold mb-1">{link.name}</h3>
          <p class="text-accent text-sm font-mono">{link.handle}</p>
        </a>
      ))}
      <div class="card flex flex-col items-center text-center py-8">
        <a href="https://app.ens.domains/ckelley.eth" target="_blank" rel="noopener noreferrer" class="group flex flex-col items-center rounded-sm focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-4" aria-label="ckelley.eth ENS profile (opens in a new tab)">
          <svg class="w-8 h-8 text-slate group-hover:text-accent transition-colors mb-4" viewBox="0 0 24 32" fill="currentColor" aria-hidden="true">
            <path d="M12 0 2 16.3 12 22 22 16.3Z" opacity="0.75" />
            <path d="M12 0v22l10-5.7Z" />
            <path d="m2 18.3 10 13.7 10-13.7L12 24Z" opacity="0.75" />
            <path d="M12 24v8l10-13.7Z" />
          </svg>
          <h3 class="text-slate-light font-semibold mb-1">ENS</h3>
          <span class="text-accent text-sm font-mono group-hover:underline">ckelley.eth</span>
        </a>
        <p class="text-slate text-xs mt-3">
          CK Technology:
          <a href="https://app.ens.domains/cktech.eth" target="_blank" rel="noopener noreferrer" class="text-accent font-mono hover:underline focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-4" aria-label="CK Technology cktech.eth ENS profile (opens in a new tab)">cktech.eth</a>
        </p>
      </div>
    </div>

  </div>
</section>

<!-- Footer -->
<footer class="py-8 text-center">
  <div class="reveal">
    <div class="footer-credit">
      <p class="text-slate text-sm font-mono">
        Designed & Built by <span class="text-accent">Christopher Kelley</span>
      </p>
      <details class="footer-easter-egg">
        <summary aria-label="Jordan Jumpman: off the clock">
          <span class="jumpman-mark" aria-hidden="true"></span>
        </summary>
        <span class="easter-egg-caption">Off the clock.</span>
      </details>
    </div>
    <p class="text-slate-dark text-xs mt-2">
      Built with Astro, Tailwind CSS & Alpine.js
    </p>
  </div>
</footer>

<style>
  .contact-option { display:flex; flex-direction:column; align-items:center; text-align:center; padding:2rem 1.5rem; }
  .contact-option:focus-visible { outline:2px solid var(--color-accent); outline-offset:5px; }
  .footer-credit { display:flex; align-items:center; justify-content:center; flex-wrap:wrap; gap:0.25rem; padding:0 1.5rem; }
  .footer-easter-egg { position:relative; }
  .footer-easter-egg summary { display:flex; align-items:center; justify-content:center; width:44px; height:44px; cursor:pointer; list-style:none; border-radius:0.375rem; }
  .footer-easter-egg summary::-webkit-details-marker { display:none; }
  .footer-easter-egg summary:focus-visible { outline:2px solid var(--color-accent); outline-offset:2px; }
  .jumpman-mark { display:block; width:28px; height:30px; background:var(--color-accent); mask:url('/logos/jumpman.svg') center / contain no-repeat; transition:transform 180ms ease, filter 180ms ease; }
  .footer-easter-egg summary:hover .jumpman-mark, .footer-easter-egg summary:focus-visible .jumpman-mark { transform:translateY(-4px) rotate(-6deg); filter:drop-shadow(0 0 5px rgb(100 255 218 / 35%)); }
  .easter-egg-caption { position:absolute; bottom:calc(100% + 0.5rem); right:0; white-space:nowrap; background:var(--color-navy-light); color:var(--color-accent); border:1px solid var(--color-slate-dark); border-radius:0.375rem; padding:0.5rem 0.75rem; font-size:0.75rem; font-family:var(--font-mono); }
  .footer-easter-egg:not([open]) .easter-egg-caption { display:none; }
  @media(prefers-reduced-motion:reduce) { .jumpman-mark { transition:none; } .footer-easter-egg summary:hover .jumpman-mark, .footer-easter-egg summary:focus-visible .jumpman-mark { transform:none; } }
</style>
