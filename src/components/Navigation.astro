---
const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/technologies', label: 'Technologies' },
  { href: '/projects', label: 'Projects' },
  { href: '/education', label: 'Education' },
  { href: '/lab', label: 'Lab' },
  { href: '/ai', label: 'AI' },
  { href: '/architecture', label: 'Architecture' },
  { href: '/#contact', label: 'Contact' },
];
---

<nav
  x-data="{ scrolled: false, open: false }"
  x-init="window.addEventListener('scroll', () => { scrolled = window.scrollY > 50 })"
  :class="scrolled ? 'bg-navy/95 backdrop-blur-xs shadow-lg' : 'bg-transparent'"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="text-accent font-mono text-lg font-semibold hover:text-accent-muted transition-colors">
      CK<span class="text-slate-light">.</span>
    </a>

    <!-- Desktop Nav -->
    <ul class="hidden md:flex items-center gap-6">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class={`text-slate hover:text-accent transition-colors text-sm ${
              pathname === link.href || (link.href !== '/' && link.href !== '/#contact' && pathname.startsWith(`${link.href}/`))
                ? 'text-accent'
                : ''
            }`}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile Menu Button -->
    <button
      @click="open = !open"
      class="md:hidden text-accent p-2"
      aria-label="Toggle menu"
    >
      <svg x-show="!open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg x-show="open" x-cloak class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div
    x-show="open"
    x-cloak
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-4"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-4"
    class="md:hidden bg-navy-light border-t border-slate-dark/30"
  >
    <ul class="flex flex-col items-center gap-6 py-8">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            @click="open = false"
            class="text-slate hover:text-accent transition-colors text-lg"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  [x-cloak] { display: none !important; }
</style>
