---
// Arch Linux daily-driver backup chain. The btrfs root is laid out in flat
// subvolumes; snapper keeps an automated ~30-day window of local snapshots for
// instant rollback, while a systemd-timed restic job ships encrypted file-level
// copies of /home and /data to a Synology NAS, which HyperBackup then mirrors
// offsite to Wasabi.
interface FlowNode {
  x: number;
  y: number;
  w: number;
  title: string;
  subs?: string[];
  node?: string;
  glow?: boolean;
}

const N: Record<string, FlowNode> = {
  FS: { x: 260, y: 16, w: 260, title: 'Arch root · btrfs', subs: ['@ · @home · @log', '@pkg · @snapshots'] },
  SNAP: { x: 30, y: 156, w: 230, title: 'snapper', subs: ['timeline + cleanup timers', '~30-day local snapshots'] },
  ROLL: { x: 30, y: 300, w: 230, title: 'Instant rollback', subs: ['boot into snapshot', 'pre/post pacman'], node: '#34d399' },
  RESTIC: { x: 470, y: 156, w: 280, title: 'restic · encrypted', subs: ['/home + /data file-level', 'daily · keep 7d·4w·6m'] },
  SYN: { x: 495, y: 300, w: 255, title: 'Synology NAS', subs: ['restic repo target', '2nd media · on-site'] },
  HB: { x: 495, y: 430, w: 255, title: 'HyperBackup', subs: ['NAS → cloud sync'] },
  WAS: { x: 290, y: 528, w: 240, title: 'Wasabi S3', subs: ['offsite · encrypted'], node: '#64ffda', glow: true },
};

const lineH = 13;
const h = (n: FlowNode) => 28 + (n.subs?.length ?? 0) * lineH;
const cx = (n: FlowNode) => n.x + n.w / 2;
const bottom = (id: string) => ({ x: cx(N[id]), y: N[id].y + h(N[id]) });
const top = (id: string) => ({ x: cx(N[id]), y: N[id].y });

type Pt = { x: number; y: number };
const vpath = (a: Pt, b: Pt) =>
  `M ${a.x} ${a.y} C ${a.x} ${(a.y + b.y) / 2}, ${b.x} ${(a.y + b.y) / 2}, ${b.x} ${b.y}`;

interface FlowEdge { from: string; to: string; label?: string[]; }
const edges: FlowEdge[] = [
  { from: 'FS', to: 'SNAP', label: ['snapshot'] },
  { from: 'SNAP', to: 'ROLL' },
  { from: 'FS', to: 'RESTIC', label: ['daily · encrypted'] },
  { from: 'RESTIC', to: 'SYN' },
  { from: 'SYN', to: 'HB' },
  { from: 'HB', to: 'WAS', label: ['offsite'] },
];

const firstY = (n: FlowNode) => {
  const lines = 1 + (n.subs?.length ?? 0);
  const block = 11 + (lines - 1) * lineH;
  return n.y + (h(n) - block) / 2 + 9;
};

const chip = (e: FlowEdge) => {
  const a = bottom(e.from);
  const b = top(e.to);
  const mx = (a.x + b.x) / 2;
  const my = (a.y + b.y) / 2;
  const lines = e.label ?? [];
  const longest = lines.reduce((m, s) => Math.max(m, s.length), 0);
  return { mx, my, w: longest * 5.4 + 14, ht: lines.length * 12 + 8, lines };
};
---

<div class="flow-wrap" style="--node:#3b82f6; --edge:#3a5a8a;">
  <svg class="flow-svg" viewBox="0 0 780 600" role="img" aria-labelledby="arch-title arch-desc">
    <title id="arch-title">Arch Linux btrfs, snapper, and restic backup chain</title>
    <desc id="arch-desc">
      The btrfs root uses flat subvolumes. snapper keeps an automated thirty-day window of local
      snapshots for instant rollback, while a systemd-timed restic job ships encrypted file-level
      copies of /home and /data to a Synology NAS that HyperBackup mirrors offsite to Wasabi.
    </desc>
    <defs>
      <marker id="arrow-arch" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse" aria-hidden="true">
        <path d="M0,0 L10,5 L0,10 z" fill="context-stroke" />
      </marker>
    </defs>

    <rect class="flow-group" x="14" y="138" width="262" height="296" rx="10" />
    <text class="flow-group-label" x="30" y="158">local · btrfs snapshots</text>
    <rect class="flow-group" x="479" y="282" width="287" height="216" rx="10" />
    <text class="flow-group-label" x="495" y="302">Synology · 2nd media</text>

    {edges.map((e) => (
      <path class="flow-edge" d={vpath(bottom(e.from), top(e.to))} marker-end="url(#arrow-arch)" />
    ))}

    {edges.filter((e) => e.label).map((e) => {
      const c = chip(e);
      return (
        <g>
          <rect class="flow-edge-chip" x={c.mx - c.w / 2} y={c.my - c.ht / 2} width={c.w} height={c.ht} rx="4" />
          {c.lines.map((s, i) => (
            <text class="flow-edge-label" x={c.mx} y={c.my - c.ht / 2 + 13 + i * 12} text-anchor="middle">{s}</text>
          ))}
        </g>
      );
    })}

    {Object.values(N).map((n) => (
      <g style={n.node ? `--node:${n.node}` : undefined}>
        <rect class={`flow-node${n.glow ? ' flow-node--glow' : ''}`} x={n.x} y={n.y} width={n.w} height={h(n)} rx="8" />
        <text class="flow-title" x={cx(n)} y={firstY(n)} text-anchor="middle">{n.title}</text>
        {n.subs?.map((s, i) => (
          <text class="flow-sub" x={cx(n)} y={firstY(n) + 14 + i * lineH} text-anchor="middle">{s}</text>
        ))}
      </g>
    ))}
  </svg>
</div>
