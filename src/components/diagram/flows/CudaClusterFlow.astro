---
// Workload placement across dedicated GPU endpoints and the Spark pair.
interface FlowNode {
  x: number;
  y: number;
  w: number;
  title: string;
  subs?: string[];
  node?: string;
  glow?: boolean;
}

const N: Record<string, FlowNode> = {
  JOB: { x: 20, y: 146, w: 200, title: 'CUDA job', subs: ['train · infer', 'batch compute'] },
  SCHED: { x: 300, y: 146, w: 230, title: 'Workload placement', subs: ['model size · GPU memory', 'available capacity'], node: '#fbbf24' },
  G1: { x: 624, y: 24, w: 250, title: 'RTX 4090 node', subs: ['24 GB · heavy compute'], node: '#a855f7', glow: true },
  G2: { x: 624, y: 88, w: 250, title: 'RTX 3070 node', subs: ['8 GB · mid inference'], node: '#a855f7' },
  G3: { x: 624, y: 152, w: 250, title: '2× RTX 2060 nodes', subs: ['CI · light inference'], node: '#a855f7' },
  G4: { x: 624, y: 216, w: 250, title: '2× DGX Spark', subs: ['200 Gb/s · distributed serving'], node: '#22d3ee', glow: true },
  G5: { x: 624, y: 280, w: 250, title: 'RTX 5090 (desktop)', subs: ['daily inference · image/video'], node: '#a855f7', glow: true },
};

const lineH = 13;
const h = (n: FlowNode) => 28 + (n.subs?.length ?? 0) * lineH;
const cx = (n: FlowNode) => n.x + n.w / 2;
const cy = (n: FlowNode) => n.y + h(n) / 2;
const left = (id: string) => ({ x: N[id].x, y: cy(N[id]) });
const right = (id: string) => ({ x: N[id].x + N[id].w, y: cy(N[id]) });

type Pt = { x: number; y: number };
const hpath = (a: Pt, b: Pt) =>
  `M ${a.x} ${a.y} C ${(a.x + b.x) / 2} ${a.y}, ${(a.x + b.x) / 2} ${b.y}, ${b.x} ${b.y}`;

interface FlowEdge { from: string; to: string; label?: string[]; }
const flows: FlowEdge[] = [
  { from: 'JOB', to: 'SCHED', label: ['submit'] },
  { from: 'SCHED', to: 'G1' },
  { from: 'SCHED', to: 'G2' },
  { from: 'SCHED', to: 'G3' },
  { from: 'SCHED', to: 'G4' },
  { from: 'SCHED', to: 'G5' },
];

const firstY = (n: FlowNode) => {
  const lines = 1 + (n.subs?.length ?? 0);
  const block = 11 + (lines - 1) * lineH;
  return n.y + (h(n) - block) / 2 + 9;
};

const chip = (e: FlowEdge) => {
  const a = right(e.from);
  const b = left(e.to);
  const mx = (a.x + b.x) / 2;
  const my = (a.y + b.y) / 2;
  const lines = e.label ?? [];
  const longest = lines.reduce((m, s) => Math.max(m, s.length), 0);
  return { mx, my, w: longest * 5.4 + 14, ht: lines.length * 12 + 8, lines };
};
---

<div class="flow-wrap" style="--node:#3b82f6; --edge:#3a5a8a;">
  <svg class="flow-svg" viewBox="0 0 904 372" role="img" aria-labelledby="cuda-c-title cuda-c-desc">
    <title id="cuda-c-title">CUDA across the Proxmox cluster</title>
    <desc id="cuda-c-desc">
      Workloads are placed according to model requirements and available GPU capacity.
      The RTX 5090, RTX 4090, and two-node DGX Spark cluster are the primary daily systems.
      RTX 3070 and RTX 2060 resources support smaller workloads and CI. AMD and integrated
      GPUs handle work outside the CUDA stack.
    </desc>
    <defs>
      <marker id="arrow-cuda-c" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse" aria-hidden="true">
        <path d="M0,0 L10,5 L0,10 z" fill="context-stroke" />
      </marker>
    </defs>

    <rect class="flow-group" x="608" y="8" width="288" height="336" rx="10" />

    {flows.map((e) => (
      <path class="flow-edge" d={hpath(right(e.from), left(e.to))} marker-end="url(#arrow-cuda-c)" />
    ))}

    {flows.filter((e) => e.label).map((e) => {
      const c = chip(e);
      return (
        <g>
          <rect class="flow-edge-chip" x={c.mx - c.w / 2} y={c.my - c.ht / 2} width={c.w} height={c.ht} rx="4" />
          {c.lines.map((s, i) => (
            <text class="flow-edge-label" x={c.mx} y={c.my - c.ht / 2 + 13 + i * 12} text-anchor="middle">{s}</text>
          ))}
        </g>
      );
    })}

    {Object.values(N).map((n) => (
      <g style={n.node ? `--node:${n.node}` : undefined}>
        <rect class={`flow-node${n.glow ? ' flow-node--glow' : ''}`} x={n.x} y={n.y} width={n.w} height={h(n)} rx="8" />
        <text class="flow-title" x={cx(n)} y={firstY(n)} text-anchor="middle">{n.title}</text>
        {n.subs?.map((s, i) => (
          <text class="flow-sub" x={cx(n)} y={firstY(n) + 14 + i * lineH} text-anchor="middle">{s}</text>
        ))}
      </g>
    ))}

    <text class="flow-sub" x="452" y="364" text-anchor="middle">AMD (RX 570) and iGPU-only nodes sit outside the CUDA pool and take non-CUDA work</text>
  </svg>
</div>
