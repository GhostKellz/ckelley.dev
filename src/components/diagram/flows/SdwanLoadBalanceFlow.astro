---
// SD-WAN link load balancing: unlike failover, both WAN members carry traffic
// concurrently. The load-balance algorithm spreads sessions across wan1 fiber
// and port2 cable by bandwidth ratio (with spillover) for aggregate throughput.
interface FlowNode {
  x: number;
  y: number;
  w: number;
  title: string;
  subs?: string[];
  node?: string;
  glow?: boolean;
}

const N: Record<string, FlowNode> = {
  SESS: { x: 250, y: 16, w: 200, title: 'Sessions (LAN)', subs: ['new connections'] },
  ALG: { x: 225, y: 150, w: 250, title: 'Load-balance algo', subs: ['volume ratio · sessions', 'source-dest-IP · spillover'] },
  M1: { x: 140, y: 332, w: 210, title: 'WAN1 · Fiber', subs: ['≈70% by bandwidth'], glow: true },
  M2: { x: 400, y: 332, w: 210, title: 'WAN2 · Cable', subs: ['≈30% by bandwidth'] },
  NET: { x: 250, y: 440, w: 200, title: 'Internet', node: '#64ffda', glow: true },
};

const lineH = 13;
const h = (n: FlowNode) => 28 + (n.subs?.length ?? 0) * lineH;
const cx = (n: FlowNode) => n.x + n.w / 2;
const bottom = (id: string) => ({ x: cx(N[id]), y: N[id].y + h(N[id]) });
const top = (id: string) => ({ x: cx(N[id]), y: N[id].y });

type Pt = { x: number; y: number };
const vpath = (a: Pt, b: Pt) =>
  `M ${a.x} ${a.y} C ${a.x} ${(a.y + b.y) / 2}, ${b.x} ${(a.y + b.y) / 2}, ${b.x} ${b.y}`;

interface FlowEdge { from: string; to: string; label?: string[]; }
const edges: FlowEdge[] = [
  { from: 'SESS', to: 'ALG' },
  { from: 'ALG', to: 'M1', label: ['≈70%'] },
  { from: 'ALG', to: 'M2', label: ['≈30%'] },
  { from: 'M1', to: 'NET' },
  { from: 'M2', to: 'NET' },
];

const firstY = (n: FlowNode) => {
  const lines = 1 + (n.subs?.length ?? 0);
  const block = 11 + (lines - 1) * lineH;
  return n.y + (h(n) - block) / 2 + 9;
};

const chip = (e: FlowEdge) => {
  const a = bottom(e.from);
  const b = top(e.to);
  const mx = (a.x + b.x) / 2;
  const my = (a.y + b.y) / 2;
  const lines = e.label ?? [];
  const longest = lines.reduce((m, s) => Math.max(m, s.length), 0);
  return { mx, my, w: longest * 5.4 + 14, ht: lines.length * 12 + 8, lines };
};
---

<div class="flow-wrap" style="--node:#22d3ee; --edge:#3a8aa0;">
  <svg class="flow-svg" viewBox="0 0 700 480" role="img" aria-labelledby="sdwanlb-title sdwanlb-desc">
    <title id="sdwanlb-title">SD-WAN link load balancing across both WAN members</title>
    <desc id="sdwanlb-desc">
      New LAN sessions are spread by the SD-WAN load-balance algorithm across both active members,
      with roughly 70 percent on the WAN1 fiber link and 30 percent on the WAN2 cable link by
      bandwidth. This aggregates egress to the internet rather than failing over.
    </desc>
    <defs>
      <marker id="arrow-sdwanlb" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse" aria-hidden="true">
        <path d="M0,0 L10,5 L0,10 z" fill="context-stroke" />
      </marker>
    </defs>

    <rect class="flow-group" x="100" y="300" width="500" height="120" rx="10" />
    <text class="flow-group-label" x="116" y="320">Both WAN members active</text>

    {edges.map((e) => (
      <path class="flow-edge" d={vpath(bottom(e.from), top(e.to))} marker-end="url(#arrow-sdwanlb)" />
    ))}

    {edges.filter((e) => e.label).map((e) => {
      const c = chip(e);
      return (
        <g>
          <rect class="flow-edge-chip" x={c.mx - c.w / 2} y={c.my - c.ht / 2} width={c.w} height={c.ht} rx="4" />
          {c.lines.map((s, i) => (
            <text class="flow-edge-label" x={c.mx} y={c.my - c.ht / 2 + 13 + i * 12} text-anchor="middle">{s}</text>
          ))}
        </g>
      );
    })}

    {Object.values(N).map((n) => (
      <g style={n.node ? `--node:${n.node}` : undefined}>
        <rect class={`flow-node${n.glow ? ' flow-node--glow' : ''}`} x={n.x} y={n.y} width={n.w} height={h(n)} rx="8" />
        <text class="flow-title" x={cx(n)} y={firstY(n)} text-anchor="middle">{n.title}</text>
        {n.subs?.map((s, i) => (
          <text class="flow-sub" x={cx(n)} y={firstY(n) + 14 + i * lineH} text-anchor="middle">{s}</text>
        ))}
      </g>
    ))}
  </svg>
</div>
