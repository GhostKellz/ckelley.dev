---
// Hyper-V lab backup chain with Veeam. Hyper-V's checkpoint/VSS integration lets
// Veeam take application-consistent full image backups daily plus incrementals,
// kept hot in a local repo for ~45 days of fast restore. Older restore points age
// out to a Wasabi capacity tier, encrypted client-side and stored deduplicated.
interface FlowNode {
  x: number;
  y: number;
  w: number;
  title: string;
  subs?: string[];
  node?: string;
  glow?: boolean;
}

const N: Record<string, FlowNode> = {
  HV: { x: 240, y: 16, w: 250, title: 'Hyper-V lab', subs: ['VM hosts · checkpoints', 'VSS app-consistent'] },
  VEEAM: { x: 235, y: 156, w: 260, title: 'Veeam B&R', subs: ['full image · daily', '+ incrementals'], node: '#fbbf24' },
  LOCAL: { x: 235, y: 296, w: 260, title: 'Local repo', subs: ['hot · fast restore', '~45-day retention'] },
  AGE: { x: 235, y: 424, w: 260, title: 'Aging tier', subs: ['restore points > 45d', 'offload to cloud'] },
  WAS: { x: 245, y: 540, w: 240, title: 'Wasabi S3', subs: ['client-encrypted', 'dedup · at rest'], node: '#64ffda', glow: true },
};

const lineH = 13;
const h = (n: FlowNode) => 28 + (n.subs?.length ?? 0) * lineH;
const cx = (n: FlowNode) => n.x + n.w / 2;
const bottom = (id: string) => ({ x: cx(N[id]), y: N[id].y + h(N[id]) });
const top = (id: string) => ({ x: cx(N[id]), y: N[id].y });

type Pt = { x: number; y: number };
const vpath = (a: Pt, b: Pt) =>
  `M ${a.x} ${a.y} C ${a.x} ${(a.y + b.y) / 2}, ${b.x} ${(a.y + b.y) / 2}, ${b.x} ${b.y}`;

interface FlowEdge { from: string; to: string; label?: string[]; }
const edges: FlowEdge[] = [
  { from: 'HV', to: 'VEEAM', label: ['snapshot'] },
  { from: 'VEEAM', to: 'LOCAL' },
  { from: 'LOCAL', to: 'AGE', label: ['age out'] },
  { from: 'AGE', to: 'WAS', label: ['encrypt → offsite'] },
];

const firstY = (n: FlowNode) => {
  const lines = 1 + (n.subs?.length ?? 0);
  const block = 11 + (lines - 1) * lineH;
  return n.y + (h(n) - block) / 2 + 9;
};

const chip = (e: FlowEdge) => {
  const a = bottom(e.from);
  const b = top(e.to);
  const mx = (a.x + b.x) / 2;
  const my = (a.y + b.y) / 2;
  const lines = e.label ?? [];
  const longest = lines.reduce((m, s) => Math.max(m, s.length), 0);
  return { mx, my, w: longest * 5.4 + 14, ht: lines.length * 12 + 8, lines };
};
---

<div class="flow-wrap" style="--node:#fbbf24; --edge:#9c7d3a;">
  <svg class="flow-svg" viewBox="0 0 730 620" role="img" aria-labelledby="veeam-title veeam-desc">
    <title id="veeam-title">Hyper-V lab backup chain with Veeam</title>
    <desc id="veeam-desc">
      Hyper-V checkpoint and VSS integration lets Veeam take application-consistent full image backups
      daily plus incrementals, kept hot in a local repo for roughly forty-five days of fast restore.
      Older restore points age out to a Wasabi capacity tier, encrypted client-side and stored deduplicated.
    </desc>
    <defs>
      <marker id="arrow-veeam" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse" aria-hidden="true">
        <path d="M0,0 L10,5 L0,10 z" fill="context-stroke" />
      </marker>
    </defs>

    <rect class="flow-group" x="219" y="138" width="292" height="304" rx="10" />
    <text class="flow-group-label" x="235" y="158">on-site · hot tier</text>

    {edges.map((e) => (
      <path class="flow-edge" d={vpath(bottom(e.from), top(e.to))} marker-end="url(#arrow-veeam)" />
    ))}

    {edges.filter((e) => e.label).map((e) => {
      const c = chip(e);
      return (
        <g>
          <rect class="flow-edge-chip" x={c.mx - c.w / 2} y={c.my - c.ht / 2} width={c.w} height={c.ht} rx="4" />
          {c.lines.map((s, i) => (
            <text class="flow-edge-label" x={c.mx} y={c.my - c.ht / 2 + 13 + i * 12} text-anchor="middle">{s}</text>
          ))}
        </g>
      );
    })}

    {Object.values(N).map((n) => (
      <g style={n.node ? `--node:${n.node}` : undefined}>
        <rect class={`flow-node${n.glow ? ' flow-node--glow' : ''}`} x={n.x} y={n.y} width={n.w} height={h(n)} rx="8" />
        <text class="flow-title" x={cx(n)} y={firstY(n)} text-anchor="middle">{n.title}</text>
        {n.subs?.map((s, i) => (
          <text class="flow-sub" x={cx(n)} y={firstY(n) + 14 + i * lineH} text-anchor="middle">{s}</text>
        ))}
      </g>
    ))}
  </svg>
</div>
