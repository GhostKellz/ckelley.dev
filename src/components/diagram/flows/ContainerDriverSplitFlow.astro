---
// Where the GPU driver lives. The physical card is bound to vfio-pci on the
// Proxmox host, which carries no GPU driver (nouveau + nvidia blacklisted). It
// passes through to a Linux VM that holds the one and only GPU driver
// (nvidia-open). Containers ship with no driver at all — the NVIDIA Container
// Toolkit injects the device and CUDA libraries at runtime, keeping images portable.
interface FlowNode {
  x: number;
  y: number;
  w: number;
  title: string;
  subs?: string[];
  node?: string;
  glow?: boolean;
}

const N: Record<string, FlowNode> = {
  GPU: { x: 20, y: 60, w: 180, title: 'Physical GPU', subs: ['one card'], node: '#64ffda', glow: true },
  HOST: { x: 260, y: 53, w: 240, title: 'Proxmox host', subs: ['drivers blacklisted', 'no GPU driver'], node: '#3b82f6' },
  VM: { x: 560, y: 53, w: 240, title: 'Linux VM', subs: ['nvidia-open driver', '★ the only driver'], node: '#22d3ee', glow: true },
  CONT: { x: 860, y: 53, w: 240, title: 'Containers', subs: ['no driver in image', 'libs injected at run'], node: '#34d399' },
};

const lineH = 13;
const h = (n: FlowNode) => 28 + (n.subs?.length ?? 0) * lineH;
const cx = (n: FlowNode) => n.x + n.w / 2;
const cy = (n: FlowNode) => n.y + h(n) / 2;
const left = (id: string) => ({ x: N[id].x, y: cy(N[id]) });
const right = (id: string) => ({ x: N[id].x + N[id].w, y: cy(N[id]) });

type Pt = { x: number; y: number };
const hpath = (a: Pt, b: Pt) =>
  `M ${a.x} ${a.y} C ${(a.x + b.x) / 2} ${a.y}, ${(a.x + b.x) / 2} ${b.y}, ${b.x} ${b.y}`;

interface FlowEdge { from: string; to: string; label?: string[]; }
const flows: FlowEdge[] = [
  { from: 'GPU', to: 'HOST', label: ['vfio-pci'] },
  { from: 'HOST', to: 'VM', label: ['passthrough'] },
  { from: 'VM', to: 'CONT', label: ['toolkit'] },
];

const firstY = (n: FlowNode) => {
  const lines = 1 + (n.subs?.length ?? 0);
  const block = 11 + (lines - 1) * lineH;
  return n.y + (h(n) - block) / 2 + 9;
};

const chip = (e: FlowEdge) => {
  const a = right(e.from);
  const b = left(e.to);
  const mx = (a.x + b.x) / 2;
  const my = (a.y + b.y) / 2;
  const lines = e.label ?? [];
  const longest = lines.reduce((m, s) => Math.max(m, s.length), 0);
  return { mx, my, w: longest * 5.4 + 14, ht: lines.length * 12 + 8, lines };
};
---

<div class="flow-wrap" style="--node:#3b82f6; --edge:#3a5a8a;">
  <svg class="flow-svg" viewBox="0 0 1120 184" role="img" aria-labelledby="cds-title cds-desc">
    <title id="cds-title">Where the GPU driver lives across host, VM, and containers</title>
    <desc id="cds-desc">
      The physical GPU is bound to vfio-pci on the Proxmox host, which carries no GPU driver because
      nouveau and the nvidia driver are blacklisted. It passes through to a Linux VM that holds the one
      and only GPU driver, nvidia-open. Containers ship with no driver at all. The NVIDIA Container
      Toolkit injects the device and CUDA libraries at runtime, keeping the images portable.
    </desc>
    <defs>
      <marker id="arrow-cds" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse" aria-hidden="true">
        <path d="M0,0 L10,5 L0,10 z" fill="context-stroke" />
      </marker>
    </defs>

    {flows.map((e) => (
      <path class="flow-edge" d={hpath(right(e.from), left(e.to))} marker-end="url(#arrow-cds)" />
    ))}

    {flows.filter((e) => e.label).map((e) => {
      const c = chip(e);
      return (
        <g>
          <rect class="flow-edge-chip" x={c.mx - c.w / 2} y={c.my - c.ht / 2} width={c.w} height={c.ht} rx="4" />
          {c.lines.map((s, i) => (
            <text class="flow-edge-label" x={c.mx} y={c.my - c.ht / 2 + 13 + i * 12} text-anchor="middle">{s}</text>
          ))}
        </g>
      );
    })}

    {Object.values(N).map((n) => (
      <g style={n.node ? `--node:${n.node}` : undefined}>
        <rect class={`flow-node${n.glow ? ' flow-node--glow' : ''}`} x={n.x} y={n.y} width={n.w} height={h(n)} rx="8" />
        <text class="flow-title" x={cx(n)} y={firstY(n)} text-anchor="middle">{n.title}</text>
        {n.subs?.map((s, i) => (
          <text class="flow-sub" x={cx(n)} y={firstY(n) + 14 + i * lineH} text-anchor="middle">{s}</text>
        ))}
      </g>
    ))}

    <text class="flow-sub" x="560" y="172" text-anchor="middle">The GPU driver lives in exactly one place, the VM. The host stays out of the way; container images stay portable.</text>
  </svg>
</div>
