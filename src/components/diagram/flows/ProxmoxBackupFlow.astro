---
// Proxmox cluster backup chain. Running guests on ZFS feed two on-site copies —
// node-to-node ZFS replication for warm standby and Proxmox Backup Server for
// incremental, deduplicated, client-encrypted snapshots — while both the local
// PBS and the offsite cloud PVE node sync to Wasabi for the geo-separated copy.
interface FlowNode {
  x: number;
  y: number;
  w: number;
  title: string;
  subs?: string[];
  node?: string;
  glow?: boolean;
}

const N: Record<string, FlowNode> = {
  GUESTS: { x: 300, y: 16, w: 240, title: 'Proxmox guests', subs: ['VMs · LXC on ZFS'] },
  ZFSREP: { x: 30, y: 168, w: 240, title: 'ZFS replication', subs: ['node → node', 'warm standby'], node: '#34d399' },
  PBS: { x: 310, y: 168, w: 260, title: 'Proxmox Backup Server', subs: ['incremental · dedup', 'client-encrypted'] },
  CLOUD: { x: 610, y: 168, w: 200, title: 'Cloud PVE node', subs: ['offsite member', 'own backup job'] },
  WAS: { x: 300, y: 372, w: 240, title: 'Wasabi S3', subs: ['offsite · dedup', 'encrypted at rest'], node: '#64ffda', glow: true },
};

const lineH = 13;
const h = (n: FlowNode) => 28 + (n.subs?.length ?? 0) * lineH;
const cx = (n: FlowNode) => n.x + n.w / 2;
const bottom = (id: string) => ({ x: cx(N[id]), y: N[id].y + h(N[id]) });
const top = (id: string) => ({ x: cx(N[id]), y: N[id].y });

type Pt = { x: number; y: number };
const vpath = (a: Pt, b: Pt) =>
  `M ${a.x} ${a.y} C ${a.x} ${(a.y + b.y) / 2}, ${b.x} ${(a.y + b.y) / 2}, ${b.x} ${b.y}`;

interface FlowEdge { from: string; to: string; label?: string[]; }
const edges: FlowEdge[] = [
  { from: 'GUESTS', to: 'ZFSREP', label: ['warm'] },
  { from: 'GUESTS', to: 'PBS', label: ['nightly'] },
  { from: 'PBS', to: 'WAS', label: ['sync · offsite'] },
  { from: 'CLOUD', to: 'WAS', label: ['offsite'] },
];

const firstY = (n: FlowNode) => {
  const lines = 1 + (n.subs?.length ?? 0);
  const block = 11 + (lines - 1) * lineH;
  return n.y + (h(n) - block) / 2 + 9;
};

const chip = (e: FlowEdge) => {
  const a = bottom(e.from);
  const b = top(e.to);
  const mx = (a.x + b.x) / 2;
  const my = (a.y + b.y) / 2;
  const lines = e.label ?? [];
  const longest = lines.reduce((m, s) => Math.max(m, s.length), 0);
  return { mx, my, w: longest * 5.4 + 14, ht: lines.length * 12 + 8, lines };
};
---

<div class="flow-wrap" style="--node:#3b82f6; --edge:#3a5a8a;">
  <svg class="flow-svg" viewBox="0 0 840 480" role="img" aria-labelledby="pve-title pve-desc">
    <title id="pve-title">Proxmox cluster backup and offsite chain</title>
    <desc id="pve-desc">
      Proxmox guests on ZFS feed two on-site copies. Node-to-node ZFS replication provides warm
      standby, and Proxmox Backup Server keeps incremental, deduplicated, client-encrypted snapshots.
      Both the local PBS and the offsite cloud PVE node sync to Wasabi for the geo-separated copy.
    </desc>
    <defs>
      <marker id="arrow-pve" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse" aria-hidden="true">
        <path d="M0,0 L10,5 L0,10 z" fill="context-stroke" />
      </marker>
    </defs>

    <rect class="flow-group" x="14" y="150" width="566" height="116" rx="10" />
    <text class="flow-group-label" x="30" y="170">on-site cluster</text>

    {edges.map((e) => (
      <path class="flow-edge" d={vpath(bottom(e.from), top(e.to))} marker-end="url(#arrow-pve)" />
    ))}

    {edges.filter((e) => e.label).map((e) => {
      const c = chip(e);
      return (
        <g>
          <rect class="flow-edge-chip" x={c.mx - c.w / 2} y={c.my - c.ht / 2} width={c.w} height={c.ht} rx="4" />
          {c.lines.map((s, i) => (
            <text class="flow-edge-label" x={c.mx} y={c.my - c.ht / 2 + 13 + i * 12} text-anchor="middle">{s}</text>
          ))}
        </g>
      );
    })}

    {Object.values(N).map((n) => (
      <g style={n.node ? `--node:${n.node}` : undefined}>
        <rect class={`flow-node${n.glow ? ' flow-node--glow' : ''}`} x={n.x} y={n.y} width={n.w} height={h(n)} rx="8" />
        <text class="flow-title" x={cx(n)} y={firstY(n)} text-anchor="middle">{n.title}</text>
        {n.subs?.map((s, i) => (
          <text class="flow-sub" x={cx(n)} y={firstY(n) + 14 + i * lineH} text-anchor="middle">{s}</text>
        ))}
      </g>
    ))}
  </svg>
</div>
