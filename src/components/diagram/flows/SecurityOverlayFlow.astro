---
// Security overlays, recreating the heimdall `flowchart LR`.
// External subgraph (CrowdSec LAPI + Wazuh indexer) → labeled edges →
// Prometheus → Grafana CrowdSec Overview, and Wazuh → Grafana Wazuh SIEM.
interface FlowNode {
  x: number;
  y: number;
  w: number;
  title: string;
  subs?: string[];
  node?: string;
  glow?: boolean;
}

const N: Record<string, FlowNode> = {
  CS: { x: 30, y: 44, w: 210, title: 'CrowdSec LAPI', subs: ['10.0.0.23 (central)'], node: '#f87171' },
  WZ: { x: 30, y: 200, w: 210, title: 'Wazuh indexer', subs: ['10.0.0.25 (OpenSearch)'], node: '#f87171' },
  P: { x: 430, y: 52, w: 200, title: 'Prometheus', node: '#64ffda', glow: true },
  GCS: { x: 740, y: 44, w: 220, title: 'Grafana', subs: ['CrowdSec Overview'], node: '#64ffda', glow: true },
  GWZ: { x: 740, y: 200, w: 220, title: 'Grafana', subs: ['Wazuh SIEM (MITRE)'], node: '#64ffda', glow: true },
};

const lineH = 13;
const h = (n: FlowNode) => 28 + (n.subs?.length ?? 0) * lineH;
const cy = (n: FlowNode) => n.y + h(n) / 2;
const right = (id: string) => ({ x: N[id].x + N[id].w, y: cy(N[id]) });
const left = (id: string) => ({ x: N[id].x, y: cy(N[id]) });

type Pt = { x: number; y: number };
const hpath = (a: Pt, b: Pt) =>
  `M ${a.x} ${a.y} C ${(a.x + b.x) / 2} ${a.y}, ${(a.x + b.x) / 2} ${b.y}, ${b.x} ${b.y}`;

interface FlowEdge {
  from: string;
  to: string;
  dot?: boolean;
  label?: string[];
}
const edges: FlowEdge[] = [
  { from: 'CS', to: 'P', label: ['Prometheus scrape :6060', 'cs_* metrics'] },
  { from: 'P', to: 'GCS' },
  { from: 'WZ', to: 'GWZ', label: ['OpenSearch datasource', 'wazuh-alerts-4.x-YYYY.MM.DD'] },
];

const cx = (n: FlowNode) => n.x + n.w / 2;
const firstY = (n: FlowNode) => {
  const lines = 1 + (n.subs?.length ?? 0);
  const block = 11 + (lines - 1) * lineH;
  return n.y + (h(n) - block) / 2 + 9;
};

// Edge-label chip geometry (centered on the edge midpoint).
const chip = (e: FlowEdge) => {
  const a = right(e.from);
  const b = left(e.to);
  const mx = (a.x + b.x) / 2;
  const my = (a.y + b.y) / 2;
  const lines = e.label ?? [];
  const longest = lines.reduce((m, s) => Math.max(m, s.length), 0);
  const w = longest * 5.4 + 14;
  const ht = lines.length * 12 + 8;
  return { mx, my, w, ht, lines };
};
---

<div class="flow-wrap" style="--node:#34d399; --edge:#4f8a7c;">
  <svg
    class="flow-svg"
    viewBox="0 0 980 300"
    role="img"
    aria-labelledby="secflow-title secflow-desc"
  >
    <title id="secflow-title">Security overlays: CrowdSec and Wazuh into Grafana</title>
    <desc id="secflow-desc">
      The CrowdSec LAPI is scraped by Prometheus for cs_* metrics and surfaced in a Grafana
      CrowdSec Overview, while the Wazuh indexer is read directly as an OpenSearch datasource
      for a Grafana Wazuh SIEM dashboard. Both sources are observe-only.
    </desc>
    <defs>
      <marker id="arrow-sec" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse" aria-hidden="true">
        <path d="M0,0 L10,5 L0,10 z" fill="context-stroke" />
      </marker>
    </defs>

    <!-- External subgraph box -->
    <rect class="flow-group" x="15" y="20" width="240" height="270" rx="10" />
    <text class="flow-group-label" x="31" y="40">External</text>

    <!-- edges -->
    {edges.map((e) => (
      <path
        class={`flow-edge${e.dot ? ' flow-edge--dot' : ''}`}
        d={hpath(right(e.from), left(e.to))}
        marker-end="url(#arrow-sec)"
      />
    ))}

    <!-- edge labels -->
    {edges.filter((e) => e.label).map((e) => {
      const c = chip(e);
      return (
        <g>
          <rect class="flow-edge-chip" x={c.mx - c.w / 2} y={c.my - c.ht / 2} width={c.w} height={c.ht} rx="4" />
          {c.lines.map((s, i) => (
            <text class="flow-edge-label" x={c.mx} y={c.my - c.ht / 2 + 13 + i * 12} text-anchor="middle">{s}</text>
          ))}
        </g>
      );
    })}

    <!-- nodes -->
    {Object.values(N).map((n) => (
      <g style={n.node ? `--node:${n.node}` : undefined}>
        <rect
          class={`flow-node${n.glow ? ' flow-node--glow' : ''}`}
          x={n.x}
          y={n.y}
          width={n.w}
          height={h(n)}
          rx="8"
        />
        <text class="flow-title" x={cx(n)} y={firstY(n)} text-anchor="middle">{n.title}</text>
        {n.subs?.map((s, i) => (
          <text class="flow-sub" x={cx(n)} y={firstY(n) + 14 + i * lineH} text-anchor="middle">{s}</text>
        ))}
      </g>
    ))}
  </svg>
</div>
