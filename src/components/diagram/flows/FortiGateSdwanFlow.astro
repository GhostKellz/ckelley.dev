---
// FortiGate SD-WAN (failover + SLA steering) grounded in the real edge:
// wan1 = Fiber 2.5 GbE static (primary), port2 = ~1 GbE cable (backup),
// both in the wan-failover-link zone; Performance SLA drives steering/failover.
interface FlowNode {
  x: number;
  y: number;
  w: number;
  title: string;
  subs?: string[];
  node?: string;
  glow?: boolean;
}

const N: Record<string, FlowNode> = {
  LAN: { x: 290, y: 16, w: 240, title: 'LAN + VLANs', subs: ['10.0.0.0/24 · VLAN 10–80'] },
  RULES: { x: 270, y: 150, w: 260, title: 'SD-WAN Rules', subs: ['SLA steering · app-aware', 'source / dest rules'] },
  SLA: { x: 600, y: 150, w: 190, title: 'Performance SLA', subs: ['probes: latency', 'jitter / loss'], node: '#fbbf24' },
  M1: { x: 160, y: 332, w: 240, title: 'WAN1 — Fiber', subs: ['2.5 GbE · primary', 'static block'], glow: true },
  M2: { x: 440, y: 332, w: 240, title: 'WAN2 — Cable', subs: ['~1 GbE · backup', 'redefined LAN port'] },
  NET: { x: 300, y: 470, w: 200, title: 'Internet', node: '#64ffda', glow: true },
};

const lineH = 13;
const h = (n: FlowNode) => 28 + (n.subs?.length ?? 0) * lineH;
const cx = (n: FlowNode) => n.x + n.w / 2;
const cy = (n: FlowNode) => n.y + h(n) / 2;
const bottom = (id: string) => ({ x: cx(N[id]), y: N[id].y + h(N[id]) });
const top = (id: string) => ({ x: cx(N[id]), y: N[id].y });
const left = (id: string) => ({ x: N[id].x, y: cy(N[id]) });
const right = (id: string) => ({ x: N[id].x + N[id].w, y: cy(N[id]) });

type Pt = { x: number; y: number };
const vpath = (a: Pt, b: Pt) =>
  `M ${a.x} ${a.y} C ${a.x} ${(a.y + b.y) / 2}, ${b.x} ${(a.y + b.y) / 2}, ${b.x} ${b.y}`;
const hpath = (a: Pt, b: Pt) =>
  `M ${a.x} ${a.y} C ${(a.x + b.x) / 2} ${a.y}, ${(a.x + b.x) / 2} ${b.y}, ${b.x} ${b.y}`;

const vedges = [
  { from: 'LAN', to: 'RULES' },
  { from: 'RULES', to: 'M1' },
  { from: 'RULES', to: 'M2' },
  { from: 'M1', to: 'NET' },
  { from: 'M2', to: 'NET' },
];

const firstY = (n: FlowNode) => {
  const lines = 1 + (n.subs?.length ?? 0);
  const block = 11 + (lines - 1) * lineH;
  return n.y + (h(n) - block) / 2 + 9;
};
---

<div class="flow-wrap" style="--node:#22d3ee; --edge:#3a8aa0;">
  <svg class="flow-svg" viewBox="0 0 800 520" role="img" aria-labelledby="sdwan-title sdwan-desc">
    <title id="sdwan-title">FortiGate SD-WAN failover and SLA steering</title>
    <desc id="sdwan-desc">
      LAN and VLAN traffic hits the SD-WAN rules, which are driven by Performance SLA health
      probes and steer egress between two members — WAN1 fiber (2.5 GbE primary) and WAN2 cable
      (~1 GbE backup, a redefined LAN port) in the wan-failover-link zone — out to the internet.
    </desc>
    <defs>
      <marker id="arrow-sdwan" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse" aria-hidden="true">
        <path d="M0,0 L10,5 L0,10 z" fill="context-stroke" />
      </marker>
    </defs>

    <rect class="flow-group" x="120" y="300" width="580" height="120" rx="10" />
    <text class="flow-group-label" x="136" y="320">SD-WAN zone · wan-failover-link</text>

    {vedges.map((e) => (
      <path class="flow-edge" d={vpath(bottom(e.from), top(e.to))} marker-end="url(#arrow-sdwan)" />
    ))}
    <path class="flow-edge flow-edge--dot" d={hpath(left('SLA'), right('RULES'))} marker-end="url(#arrow-sdwan)" />

    {Object.values(N).map((n) => (
      <g style={n.node ? `--node:${n.node}` : undefined}>
        <rect class={`flow-node${n.glow ? ' flow-node--glow' : ''}`} x={n.x} y={n.y} width={n.w} height={h(n)} rx="8" />
        <text class="flow-title" x={cx(n)} y={firstY(n)} text-anchor="middle">{n.title}</text>
        {n.subs?.map((s, i) => (
          <text class="flow-sub" x={cx(n)} y={firstY(n) + 14 + i * lineH} text-anchor="middle">{s}</text>
        ))}
      </g>
    ))}
  </svg>
</div>
