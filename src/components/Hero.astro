---
const roles = [
  'Systems Administrator',
  'Cloud Administrator',
  'Security Specialist',
  'Homelab Enthusiast',
];

const terminalLines = [
  { type: 'command', text: 'whoami' },
  { type: 'output', text: 'christopher_kelley' },
  { type: 'command', text: 'cat /etc/roles' },
  { type: 'output', text: 'Systems Administrator' },
  { type: 'output', text: 'Cloud Administrator' },
  { type: 'output', text: 'Security Specialist' },
  { type: 'output', text: 'Homelab Enthusiast' },
  { type: 'command', text: './portfolio --init' },
  { type: 'output', text: 'Ready.' },
];
---

<section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Particle Background -->
  <canvas id="particles-canvas"></canvas>

  <!-- Gradient Overlay -->
  <div class="absolute inset-0 bg-linear-to-b from-navy/50 via-transparent to-navy pointer-events-none"></div>

  <!-- Content -->
  <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
    <!-- Greeting -->
    <p class="text-accent font-mono text-lg mb-4 animate-fade-in-up" style="animation-delay: 0.1s;">
      Hi, my name is
    </p>

    <!-- Name -->
    <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold text-slate-light mb-4 animate-fade-in-up" style="animation-delay: 0.2s;">
      Christopher Kelley<span class="text-accent">.</span>
    </h1>

    <!-- Typing Animation -->
    <div class="h-12 md:h-16 flex items-center justify-center animate-fade-in-up" style="animation-delay: 0.3s;">
      <span class="text-2xl md:text-4xl text-slate font-semibold">
        I'm a{' '}
        <span
          x-data={`{
            roles: ${JSON.stringify(roles)},
            currentRole: 0,
            text: '',
            isDeleting: false,
            typeSpeed: 100,
            init() {
              this.type();
            },
            type() {
              const fullText = this.roles[this.currentRole];

              if (this.isDeleting) {
                this.text = fullText.substring(0, this.text.length - 1);
              } else {
                this.text = fullText.substring(0, this.text.length + 1);
              }

              let speed = this.isDeleting ? 50 : this.typeSpeed;

              if (!this.isDeleting && this.text === fullText) {
                speed = 2000;
                this.isDeleting = true;
              } else if (this.isDeleting && this.text === '') {
                this.isDeleting = false;
                this.currentRole = (this.currentRole + 1) % this.roles.length;
                speed = 500;
              }

              setTimeout(() => this.type(), speed);
            }
          }`}
          x-text="text"
          class="text-accent"
        ></span><span class="cursor"></span>
      </span>
    </div>

    <!-- Tagline -->
    <p class="text-slate text-lg md:text-xl max-w-2xl mx-auto mt-6 mb-10 animate-fade-in-up" style="animation-delay: 0.4s;">
      Converging Technology, Security, and Innovation.<br class="hidden md:block" />
      Building tomorrow through automation, infrastructure, and code.
    </p>

    <!-- Social Links -->
    <div class="flex items-center justify-center gap-6 mb-8 animate-fade-in-up" style="animation-delay: 0.5s;">
      <a href="https://github.com/ghostkellz" target="_blank" rel="noopener" class="social-link" aria-label="GitHub">
        <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
        </svg>
      </a>
      <a href="https://linkedin.com/in/christopherkelley89" target="_blank" rel="noopener" class="social-link" aria-label="LinkedIn">
        <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <a href="https://twitter.com/gh0stKellz" target="_blank" rel="noopener" class="social-link" aria-label="Twitter">
        <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>
    </div>

    <!-- CTA Button -->
    <div class="animate-fade-in-up mb-12" style="animation-delay: 0.6s;">
      <a href="#about" class="btn btn-primary text-lg">
        Explore My Work
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
    </div>

    <!-- Terminal Widget -->
    <div
      class="animate-fade-in-up max-w-md mx-auto"
      style="animation-delay: 0.7s;"
      x-data={`{
        lines: [],
        currentLine: 0,
        currentChar: 0,
        showCursor: true,
        allLines: ${JSON.stringify(terminalLines)},
        done: false,

        init() {
          setInterval(() => this.showCursor = !this.showCursor, 530);
          this.typeNext();
        },

        typeNext() {
          if (this.currentLine >= this.allLines.length) {
            this.done = true;
            // Reset and loop after a pause
            setTimeout(() => {
              this.lines = [];
              this.currentLine = 0;
              this.currentChar = 0;
              this.done = false;
              this.typeNext();
            }, 4000);
            return;
          }

          const cmd = this.allLines[this.currentLine];
          const isCommand = cmd.type === 'command';
          const prefix = isCommand ? '$ ' : '> ';
          const fullText = prefix + cmd.text;

          if (!this.lines[this.currentLine]) {
            this.lines[this.currentLine] = { text: '', type: cmd.type };
          }

          if (this.currentChar < fullText.length) {
            this.lines[this.currentLine].text = fullText.substring(0, this.currentChar + 1);
            this.currentChar++;
            const speed = isCommand ? 60 + Math.random() * 40 : 25 + Math.random() * 20;
            setTimeout(() => this.typeNext(), speed);
          } else {
            this.currentLine++;
            this.currentChar = 0;
            const pause = this.allLines[this.currentLine - 1].type === 'command' ? 300 : 100;
            setTimeout(() => this.typeNext(), pause);
          }
        }
      }`}
    >
      <!-- Terminal Window -->
      <div class="text-left">
        <!-- Terminal Header -->
        <div class="bg-slate-dark/40 rounded-t-lg px-3 py-1.5 flex items-center gap-2">
          <div class="flex gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-red-500/70"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/70"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-green-500/70"></span>
          </div>
          <span class="text-slate/60 text-xs font-mono ml-2">chris@archlinux: ~</span>
        </div>

        <!-- Terminal Body -->
        <div class="bg-navy-light/60 backdrop-blur-xs rounded-b-lg p-4 font-mono text-xs md:text-sm border border-slate-dark/20 border-t-0 min-h-[160px]">
          <template x-for="(line, index) in lines" :key="index">
            <div class="leading-relaxed">
              <span
                :class="line.type === 'command' ? 'text-accent' : 'text-slate-light/80'"
                x-text="line.text"
              ></span>
            </div>
          </template>

          <!-- Cursor -->
          <div x-show="!done">
            <span x-show="lines.length === 0" class="text-accent">$ </span>
            <span
              x-bind:class="showCursor ? 'opacity-100' : 'opacity-0'"
              class="inline-block w-2 h-3.5 bg-accent align-middle transition-opacity"
            ></span>
          </div>
        </div>
      </div>

      <!-- Scanline effect -->
      <div class="absolute inset-0 pointer-events-none opacity-[0.02] rounded-lg bg-[repeating-linear-gradient(0deg,transparent,transparent_2px,rgba(0,0,0,0.3)_2px,rgba(0,0,0,0.3)_4px)]"></div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <a href="#about" class="text-slate hover:text-accent transition-colors">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </div>
</section>

<script>
  // Particle Network Background
  const canvas = document.getElementById('particles-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  let particles: Particle[] = [];
  const particleCount = 80;
  const maxDistance = 150;
  let mouse = { x: 0, y: 0 };

  interface Particle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    radius: number;
  }

  function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }

  function createParticles() {
    particles = [];
    for (let i = 0; i < particleCount; i++) {
      particles.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.5,
        vy: (Math.random() - 0.5) * 0.5,
        radius: Math.random() * 2 + 1,
      });
    }
  }

  function drawParticles() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // Draw connections
    for (let i = 0; i < particles.length; i++) {
      for (let j = i + 1; j < particles.length; j++) {
        const dx = particles[i].x - particles[j].x;
        const dy = particles[i].y - particles[j].y;
        const distance = Math.sqrt(dx * dx + dy * dy);

        if (distance < maxDistance) {
          const opacity = (1 - distance / maxDistance) * 0.3;
          ctx.beginPath();
          ctx.strokeStyle = `rgba(100, 255, 218, ${opacity})`;
          ctx.lineWidth = 1;
          ctx.moveTo(particles[i].x, particles[i].y);
          ctx.lineTo(particles[j].x, particles[j].y);
          ctx.stroke();
        }
      }
    }

    // Draw particles
    particles.forEach(p => {
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(100, 255, 218, 0.6)';
      ctx.fill();
    });
  }

  function updateParticles() {
    particles.forEach(p => {
      p.x += p.vx;
      p.y += p.vy;

      // Bounce off edges
      if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
      if (p.y < 0 || p.y > canvas.height) p.vy *= -1;

      // Mouse interaction
      const dx = mouse.x - p.x;
      const dy = mouse.y - p.y;
      const distance = Math.sqrt(dx * dx + dy * dy);
      if (distance < 100) {
        p.x -= dx * 0.01;
        p.y -= dy * 0.01;
      }
    });
  }

  function animate() {
    updateParticles();
    drawParticles();
    requestAnimationFrame(animate);
  }

  // Initialize
  resize();
  createParticles();
  animate();

  // Event listeners
  window.addEventListener('resize', () => {
    resize();
    createParticles();
  });

  window.addEventListener('mousemove', (e) => {
    mouse.x = e.clientX;
    mouse.y = e.clientY;
  });
</script>
