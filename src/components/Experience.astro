---
interface Experience {
  title: string;
  company: string;
  location?: string;
  date: string;
  description: string[];
  type: 'work' | 'education' | 'certification';
}

const experiences: Experience[] = [
  {
    title: 'Owner & Principal Consultant',
    company: 'CK Technology LLC',
    date: 'April 2025 - Present',
    type: 'work',
    description: [
      'Founded and operate an IT consulting firm specializing in DevOps, infrastructure, and security solutions',
      'Design and implement automated infrastructure solutions using Terraform, Ansible, and custom tooling',
      'Provide managed IT services including M365 administration, cloud hosting, and security hardening',
    ],
  },
  {
    title: 'Systems Administrator',
    company: 'Resolve Technology',
    location: 'Portsmouth, NH',
    date: 'April 2020 - April 2026',
    type: 'work',
    description: [
      'Manage enterprise infrastructure for SMB clients including virtualization, networking, and cloud services',
      'Administer Microsoft 365 tenants, Azure environments, and FortiGate security appliances',
      'Implement backup, disaster recovery, and business continuity solutions',
    ],
  },
  {
    title: 'B.S. Software Development',
    company: 'Southern New Hampshire University',
    date: '2019 - 2023',
    type: 'education',
    description: [
      'Graduated with a focus on software engineering principles and system design',
      'Coursework in data structures, algorithms, databases, and software architecture',
    ],
  },
  {
    title: 'Industry Certifications',
    company: 'CompTIA & Cisco',
    date: '2024',
    type: 'certification',
    description: [
      'CompTIA Security+ (SY0-701)',
      'CompTIA Network+ (N10-008)',
      'CompTIA Linux+ (XK0-005)',
      'Cisco CCNA (200-301)',
    ],
  },
];

const getIcon = (type: string) => {
  switch (type) {
    case 'work':
      return `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`;
    case 'education':
      return `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /></svg>`;
    case 'certification':
      return `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" /></svg>`;
    default:
      return '';
  }
};
---

<section id="experience" class="section">
  <div class="container-narrow">
    <div class="reveal text-center mb-16">
      <p class="heading-accent">04. Experience</p>
      <h2 class="heading">Where I've Worked</h2>
    </div>

    <div class="relative">
      <!-- Timeline line -->
      <div class="absolute left-0 md:left-1/2 top-0 bottom-0 w-px bg-slate-dark/50 -translate-x-1/2 hidden md:block"></div>
      <div class="absolute left-4 top-0 bottom-0 w-px bg-slate-dark/50 md:hidden"></div>

      <!-- Timeline items -->
      <div class="space-y-12">
        {experiences.map((exp, index) => (
          <div class={`reveal relative flex flex-col md:flex-row gap-8 ${index % 2 === 0 ? 'md:flex-row-reverse' : ''}`} style={`transition-delay: ${index * 0.1}s;`}>
            <!-- Timeline dot -->
            <div class="absolute left-4 md:left-1/2 w-3 h-3 bg-accent rounded-full -translate-x-1/2 mt-2 glow-sm"></div>

            <!-- Content -->
            <div class={`md:w-1/2 ${index % 2 === 0 ? 'md:pl-12' : 'md:pr-12 md:text-right'} pl-12 md:pl-0`}>
              <div class="card">
                <div class={`flex items-center gap-3 mb-3 ${index % 2 === 0 ? '' : 'md:flex-row-reverse'}`}>
                  <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent" set:html={getIcon(exp.type)} />
                  <div class={index % 2 === 0 ? '' : 'md:text-right'}>
                    <h3 class="text-lg font-semibold text-slate-light">{exp.title}</h3>
                    <p class="text-accent text-sm font-mono">{exp.company}</p>
                  </div>
                </div>

                <p class={`text-slate text-sm mb-4 font-mono ${index % 2 === 0 ? '' : 'md:text-right'}`}>
                  {exp.date}
                </p>

                <ul class={`space-y-2 ${index % 2 === 0 ? '' : 'md:text-left'}`}>
                  {exp.description.map(item => (
                    <li class="text-slate text-sm flex items-start gap-2">
                      <span class="text-accent mt-1 shrink-0">▹</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Spacer for alternating layout -->
            <div class="hidden md:block md:w-1/2"></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
